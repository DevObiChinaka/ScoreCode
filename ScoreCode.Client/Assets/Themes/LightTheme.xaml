<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════ LIGHT THEME (design-system palette) ══════ -->

    <!-- Surfaces -->
    <Color x:Key="ThBgBase">#FCFCFD</Color>
    <Color x:Key="ThBgElev">#FFFFFF</Color>
    <Color x:Key="ThBgSidebar">#FFFFFF</Color>
    <Color x:Key="ThBgPanel">#FFFFFF</Color>
    <Color x:Key="ThBgSurface">#F4F6F9</Color>
    <Color x:Key="ThBgSurface2">#F4F6F9</Color>
    <Color x:Key="ThBgInput">#FFFFFF</Color>
    <Color x:Key="ThBgHover">#EEF0F4</Color>

    <!-- Accent -->
    <Color x:Key="ThAccent">#1F5FE0</Color>
    <Color x:Key="ThAccentStrong">#1A52C8</Color>
    <Color x:Key="ThAccentDark">#1A52C8</Color>

    <!-- Text -->
    <Color x:Key="ThTextPrimary">#14171E</Color>
    <Color x:Key="ThTextSecondary">#515A69</Color>
    <Color x:Key="ThTextMuted">#8B93A2</Color>
    <Color x:Key="ThTextOnAccent">#FFFFFF</Color>

    <!-- Borders -->
    <Color x:Key="ThBorder">#E7EAEF</Color>
    <Color x:Key="ThBorderStrong">#D6DAE2</Color>

    <!-- Status -->
    <Color x:Key="ThSuccess">#0F9D74</Color>
    <Color x:Key="ThError">#CF4436</Color>
    <Color x:Key="ThWarning">#B9793A</Color>
    <Color x:Key="ThInfo">#1F5FE0</Color>

    <!-- Soft tints (badges / pills / glows) — ARGB -->
    <Color x:Key="ThAccentSoft">#171F5FE0</Color>
    <Color x:Key="ThAccentLine">#381F5FE0</Color>
    <Color x:Key="ThSuccessSoft">#1F0F9D74</Color>
    <Color x:Key="ThWarningSoft">#24B9793A</Color>
    <Color x:Key="ThErrorSoft">#1ACF4436</Color>

    <!-- Code / special. These match the Monaco 'scorecode-light' editor theme so
         the run console and result code boxes sit flush with the editor above them. -->
    <Color x:Key="ThCodeBg">#F6F7F9</Color>
    <Color x:Key="ThDeleteBg">#1ACF4436</Color>
    <Color x:Key="ThWarningBg">#24B9793A</Color>

    <!-- Code syntax -->
    <Color x:Key="ThSxKey">#CF222E</Color>
    <Color x:Key="ThSxStr">#0A7F3F</Color>
    <Color x:Key="ThSxFn">#1F6FEB</Color>
    <Color x:Key="ThSxNum">#B35900</Color>
    <Color x:Key="ThSxCom">#6A737D</Color>
    <Color x:Key="ThCodeText">#24292E</Color>

    <!-- Brushes (for XAML binding) -->
    <SolidColorBrush x:Key="ThBrBgBase"       Color="{DynamicResource ThBgBase}"/>
    <SolidColorBrush x:Key="ThBrBgElev"       Color="{DynamicResource ThBgElev}"/>
    <SolidColorBrush x:Key="ThBrBgSidebar"    Color="{DynamicResource ThBgSidebar}"/>
    <SolidColorBrush x:Key="ThBrBgPanel"      Color="{DynamicResource ThBgPanel}"/>
    <SolidColorBrush x:Key="ThBrBgSurface"    Color="{DynamicResource ThBgSurface}"/>
    <SolidColorBrush x:Key="ThBrBgSurface2"   Color="{DynamicResource ThBgSurface2}"/>
    <SolidColorBrush x:Key="ThBrBgInput"      Color="{DynamicResource ThBgInput}"/>
    <SolidColorBrush x:Key="ThBrBgHover"      Color="{DynamicResource ThBgHover}"/>
    <SolidColorBrush x:Key="ThBrAccent"       Color="{DynamicResource ThAccent}"/>
    <SolidColorBrush x:Key="ThBrAccentStrong" Color="{DynamicResource ThAccentStrong}"/>
    <SolidColorBrush x:Key="ThBrAccentDark"   Color="{DynamicResource ThAccentDark}"/>
    <SolidColorBrush x:Key="ThBrTextPrimary"  Color="{DynamicResource ThTextPrimary}"/>
    <SolidColorBrush x:Key="ThBrTextSecondary" Color="{DynamicResource ThTextSecondary}"/>
    <SolidColorBrush x:Key="ThBrTextMuted"    Color="{DynamicResource ThTextMuted}"/>
    <SolidColorBrush x:Key="ThBrTextOnAccent" Color="{DynamicResource ThTextOnAccent}"/>
    <SolidColorBrush x:Key="ThBrBorder"       Color="{DynamicResource ThBorder}"/>
    <SolidColorBrush x:Key="ThBrBorderStrong" Color="{DynamicResource ThBorderStrong}"/>
    <SolidColorBrush x:Key="ThBrSuccess"      Color="{DynamicResource ThSuccess}"/>
    <SolidColorBrush x:Key="ThBrError"        Color="{DynamicResource ThError}"/>
    <SolidColorBrush x:Key="ThBrWarning"      Color="{DynamicResource ThWarning}"/>
    <SolidColorBrush x:Key="ThBrInfo"         Color="{DynamicResource ThInfo}"/>
    <SolidColorBrush x:Key="ThBrAccentSoft"   Color="{DynamicResource ThAccentSoft}"/>
    <SolidColorBrush x:Key="ThBrAccentLine"   Color="{DynamicResource ThAccentLine}"/>
    <SolidColorBrush x:Key="ThBrSuccessSoft"  Color="{DynamicResource ThSuccessSoft}"/>
    <SolidColorBrush x:Key="ThBrWarningSoft"  Color="{DynamicResource ThWarningSoft}"/>
    <SolidColorBrush x:Key="ThBrErrorSoft"    Color="{DynamicResource ThErrorSoft}"/>
    <SolidColorBrush x:Key="ThBrCodeBg"       Color="{DynamicResource ThCodeBg}"/>
    <SolidColorBrush x:Key="ThBrCodeText"     Color="{DynamicResource ThCodeText}"/>

    <!-- Accent gradient (avatars / hero CTAs) -->
    <LinearGradientBrush x:Key="ThBrAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource ThAccentStrong}" Offset="0"/>
        <GradientStop Color="{DynamicResource ThAccent}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
