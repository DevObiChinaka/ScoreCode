<Window x:Class="ScoreCode.Client.Views.Student.ExamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ScoreCode · Exam"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ResizeMode="NoResize"
        Background="{DynamicResource ThBrBgBase}"
        FontFamily="/Assets/Fonts/#Geist">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            
            
            
            
            
            
            
            
            
            
            
            
            

            <!-- Tab button style -->
            <Style x:Key="TabBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThBrBgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ghost button -->
            <Style x:Key="BtnGhost" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThBrBgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Top bar -->
            <RowDefinition Height="Auto"/>   <!-- Question text panel -->
            <RowDefinition Height="*"/>       <!-- Editor area -->
            <RowDefinition Height="Auto"/>   <!-- Run bar (always visible) -->
            <RowDefinition Height="Auto"/>   <!-- Output panel (collapsible) -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════ TOP BAR ══════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ThBrBgSidebar}"
                BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Exam title -->
                    <ColumnDefinition Width="*"/>      <!-- Question tabs -->
                    <ColumnDefinition Width="Auto"/>  <!-- Timer -->
                    <ColumnDefinition Width="Auto"/>  <!-- Submit button -->
                </Grid.ColumnDefinitions>

                <!-- Exam title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Border Width="24" Height="24" CornerRadius="5"
                            Background="{DynamicResource ThBrAccent}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ThBrBgBase}" Width="5" Height="5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource ThBrBgBase}" Width="5" Height="5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ThBrBgBase}" Width="5" Height="5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource ThBrBgBase}" Width="5" Height="5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TxtExamTitle" Text="Exam Title"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThBrTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Question tabs (scrollable) -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              Padding="0">
                    <StackPanel x:Name="QuestionTabs" Orientation="Horizontal"
                                VerticalAlignment="Stretch"/>
                </ScrollViewer>

                <!-- Timer (prominent, top-right) -->
                <Border Grid.Column="2" VerticalAlignment="Center" Margin="16,0"
                        Background="{DynamicResource ThBrBgHover}" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏱" FontSize="14" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTimer" Text="00:00:00"
                                   FontSize="18" FontWeight="Bold"
                                   FontFamily="/Assets/Fonts/#Geist Mono"
                                   Foreground="{DynamicResource ThBrAccent}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Submit button -->
                <Button Grid.Column="3" x:Name="BtnSubmit" Style="{StaticResource BtnGhost}"
                        Padding="16,8" Click="BtnSubmit_Click"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.FileCheck}"
                              Stroke="{DynamicResource ThBrTextPrimary}" StrokeThickness="1.5"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Submit Exam" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextPrimary}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════ QUESTION TEXT ══════════ -->
        <Border Grid.Row="1" Background="{DynamicResource ThBrBgSurface}"
                BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="0,0,0,1"
                Padding="24,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtQuestionLabel" Text="Question 1"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThBrAccent}"/>
                    <TextBlock x:Name="TxtQuestionMarks" Text=" · 10 marks"
                               FontSize="13" Foreground="{DynamicResource ThBrTextSecondary}"/>
                </StackPanel>
                <TextBlock x:Name="TxtQuestionText" Text="Write a program that..."
                           FontSize="14" Foreground="{DynamicResource ThBrTextPrimary}"
                           TextWrapping="Wrap" MaxWidth="900"
                           HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- ══════════ EDITOR AREA (Monaco via WebView2) ══════════ -->
        <wv2:WebView2 Grid.Row="2" x:Name="Editor"
                      DefaultBackgroundColor="#0D1117"/>

        <!-- ══════════ RUN BAR (always visible) ══════════ -->
        <Border Grid.Row="3" Background="{DynamicResource ThBrBgBase}" BorderBrush="{DynamicResource ThBrBorder}"
                BorderThickness="0,1,0,0" Padding="16,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnRun" Style="{StaticResource BtnGhost}"
                        Padding="12,5" Click="BtnRun_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" FontSize="10" Foreground="{DynamicResource ThBrAccent}"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Run Code" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrAccent}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnGhost}"
                        Padding="10,5" Click="BtnClearOutput_Click" Margin="4,0,0,0">
                    <TextBlock Text="Clear" FontSize="12"
                               Foreground="{DynamicResource ThBrTextSecondary}"/>
                </Button>
                <TextBlock x:Name="TxtExecTime" Text=""
                           FontSize="11" Foreground="{DynamicResource ThBrTextMuted}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════ OUTPUT PANEL (collapsible) ══════════ -->
        <Border Grid.Row="4" x:Name="OutputPanel"
                Background="{DynamicResource ThBrBgSidebar}" BorderBrush="{DynamicResource ThBrBorder}"
                BorderThickness="0,1,0,0" Visibility="Collapsed">
            <Grid>
                <ScrollViewer x:Name="OutputTextScroll" MaxHeight="180"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtOutput" Text=""
                               FontSize="13" FontFamily="'JetBrains Mono', Consolas"
                               Foreground="{DynamicResource ThBrTextPrimary}"
                               Background="Transparent" TextWrapping="NoWrap"
                               Padding="16,8"/>
                </ScrollViewer>
                <!-- HTML/CSS live preview (shown instead of text for those languages) -->
                <wv2:WebView2 x:Name="PreviewWeb" Height="300" Visibility="Collapsed"
                              DefaultBackgroundColor="White"/>
            </Grid>
        </Border>

        <!-- ══════════ STATUS BAR ══════════ -->
        <Border Grid.Row="5" Background="{DynamicResource ThBrBgSidebar}"
                BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="0,1,0,0"
                Padding="16,0" Height="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Q number -->
                    <ColumnDefinition Width="Auto"/>  <!-- Language -->
                    <ColumnDefinition Width="Auto"/>  <!-- Progress -->
                    <ColumnDefinition Width="*"/>      <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>  <!-- Autosave -->
                </Grid.ColumnDefinitions>

                <!-- Question number -->
                <TextBlock Grid.Column="0" x:Name="TxtStatusQuestion"
                           Text="Q1 of 5" FontSize="11"
                           Foreground="{DynamicResource ThBrTextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Language -->
                <Border Grid.Column="1" Background="{DynamicResource ThBrBgHover}" CornerRadius="3"
                        Padding="6,2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TxtStatusLang" Text="Python" FontSize="11"
                               Foreground="{DynamicResource ThBrAccent}"/>
                </Border>

                <!-- Progress dots -->
                <StackPanel Grid.Column="2" x:Name="ProgressDots" Orientation="Horizontal"
                            VerticalAlignment="Center"/>

                <!-- Autosave status -->
                <TextBlock Grid.Column="4" x:Name="TxtAutosave"
                           Text="Not saved yet" FontSize="11"
                           Foreground="{DynamicResource ThBrTextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════ SUBMISSION OVERLAY (hidden by default) ══════════ -->
        <Border x:Name="SubmissionOverlay" Grid.Row="0" Grid.RowSpan="6"
                Background="#F00D1117" Visibility="Collapsed"
                Panel.ZIndex="100">
            <Border Background="{DynamicResource ThBrBgSurface}" CornerRadius="16"
                    BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1"
                    Padding="48,40" MaxWidth="480" MaxHeight="320"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Status icon -->
                    <TextBlock x:Name="TxtSubmitIcon" Text="📤"
                               FontSize="40" HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Status heading -->
                    <TextBlock x:Name="TxtSubmitStatus"
                               Text="Submitting your exam..."
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource ThBrTextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Detail text -->
                    <TextBlock x:Name="TxtSubmitDetail"
                               Text="Please wait while we upload your answers."
                               FontSize="13"
                               Foreground="{DynamicResource ThBrTextSecondary}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Retry button (hidden until failure) -->
                    <Button x:Name="BtnRetry" Content="🔄  Retry Now"
                            Visibility="Collapsed"
                            Click="BtnRetry_Click"
                            FontSize="14" FontWeight="SemiBold"
                            Foreground="White" Cursor="Hand"
                            HorizontalAlignment="Center"
                            Padding="28,12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="RetryBd" Background="{DynamicResource ThBrAccent}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RetryBd" Property="Background"
                                                Value="{DynamicResource ThBrAccentDark}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="RetryBd" Property="Opacity"
                                                Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
