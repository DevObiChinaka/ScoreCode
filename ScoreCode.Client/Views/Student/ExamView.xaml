<Window x:Class="ScoreCode.Client.Views.Student.ExamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ScoreCode · Exam"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ResizeMode="NoResize"
        Background="{DynamicResource ThBrBgBase}"
        FontFamily="/Assets/Fonts/#Geist">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Question rail item -->
            <Style x:Key="RailItem" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
                <Setter Property="Padding" Value="9,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="11" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ghost button -->
            <Style x:Key="BtnGhost" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThBrBgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- ══════════ MAIN LAYOUT: rail + editor column ══════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>   <!-- Question rail -->
                <ColumnDefinition Width="*"/>      <!-- Editor column -->
            </Grid.ColumnDefinitions>

            <!-- ══════════ QUESTION RAIL ══════════ -->
            <Border Grid.Column="0" Background="{DynamicResource ThBrBgSidebar}"
                    BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="14,16,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Header -->
                        <RowDefinition Height="Auto"/>   <!-- Label -->
                        <RowDefinition Height="*"/>       <!-- Questions -->
                        <RowDefinition Height="Auto"/>   <!-- Progress card -->
                    </Grid.RowDefinitions>

                    <!-- Header: logo + lock indicator -->
                    <Grid Grid.Row="0" Margin="2,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24" Margin="0,0,9,0">
                                <Grid Width="48" Height="48">
                                    <Border CornerRadius="12" Background="{DynamicResource ThBrBgSurface}"
                                            BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1"/>
                                    <Path Data="M33.64,12.51 A15,15 0 0 0 9,24" Stroke="{DynamicResource ThBrTextPrimary}"
                                          StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M9,24 A15,15 0 0 0 33.64,35.49" Stroke="{DynamicResource ThBrAccent}"
                                          StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M21,17 L30,24 L21,31" Stroke="#14B88A" StrokeThickness="4.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="ScoreCode" FontSize="14.5" FontWeight="Medium"
                                       Foreground="{DynamicResource ThBrTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{DynamicResource ThBrErrorSoft}" CornerRadius="999" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource ThBrError}"
                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="LOCKED" FontSize="10" FontWeight="Medium"
                                           Foreground="{DynamicResource ThBrError}"
                                           FontFamily="/Assets/Fonts/#Geist Mono"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Section label -->
                    <TextBlock Grid.Row="1" Text="QUESTIONS" FontSize="11" FontWeight="Medium"
                               FontFamily="/Assets/Fonts/#Geist Mono"
                               Foreground="{DynamicResource ThBrTextMuted}" Margin="4,0,0,10"/>

                    <!-- Question list -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="QuestionTabs"/>
                    </ScrollViewer>

                    <!-- Progress card -->
                    <Border Grid.Row="3" Background="{DynamicResource ThBrBgPanel}"
                            BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="13,12" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Progress" FontSize="12" Foreground="{DynamicResource ThBrTextSecondary}"/>
                                <TextBlock x:Name="TxtProgressCount" Text="0/0" FontSize="12" FontWeight="Medium"
                                           FontFamily="/Assets/Fonts/#Geist Mono"
                                           Foreground="{DynamicResource ThBrTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="6" CornerRadius="3" Margin="0,9,0,0"
                                    Background="{DynamicResource ThBrBgSurface2}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ProgFill" Width="0*"/>
                                        <ColumnDefinition x:Name="ProgRest" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="3" Background="{DynamicResource ThBrAccent}"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource ThBrSuccess}"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtAutosave" Text="Not saved yet" FontSize="11"
                                           Foreground="{DynamicResource ThBrTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════ EDITOR COLUMN ══════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Top strip -->
                    <RowDefinition Height="Auto"/>   <!-- Question prompt -->
                    <RowDefinition Height="*"/>       <!-- Editor -->
                    <RowDefinition Height="Auto"/>   <!-- Run bar -->
                    <RowDefinition Height="Auto"/>   <!-- Output panel -->
                </Grid.RowDefinitions>

                <!-- Top strip: title · timer · submit -->
                <Border Grid.Row="0" Background="{DynamicResource ThBrBgBase}"
                        BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="0,0,0,1"
                        Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtExamTitle" Text="Exam Title" FontSize="14.5" FontWeight="Medium"
                                       Foreground="{DynamicResource ThBrTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Timer card -->
                        <Border Grid.Column="1" x:Name="TimerCard" VerticalAlignment="Center" Margin="14,0"
                                Background="{DynamicResource ThBrBgSurface}" CornerRadius="11"
                                BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Grid Width="24" Height="24">
                                        <Ellipse Width="18" Height="18" Stroke="{DynamicResource ThBrTextSecondary}"
                                                 StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path Data="M12,7 L12,12 L15.5,14" Stroke="{DynamicResource ThBrTextSecondary}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTimer" Text="00:00:00" FontSize="17" FontWeight="Bold"
                                               FontFamily="/Assets/Fonts/#Geist Mono"
                                               Foreground="{DynamicResource ThBrAccent}"/>
                                    <TextBlock Text="remaining" FontSize="9.5" Foreground="{DynamicResource ThBrTextMuted}"
                                               Margin="0,-1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Submit button -->
                        <Button Grid.Column="2" x:Name="BtnSubmit" Click="BtnSubmit_Click"
                                VerticalAlignment="Center" Cursor="Hand" Padding="17,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SubBd" Background="{DynamicResource ThBrAccent}"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.FileCheck}"
                                                  Stroke="{DynamicResource ThBrTextOnAccent}" StrokeThickness="1.6"
                                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Text="Submit exam" FontSize="13.5" FontWeight="Medium"
                                                       Foreground="{DynamicResource ThBrTextOnAccent}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SubBd" Property="Background" Value="{DynamicResource ThBrAccentStrong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Question prompt -->
                <Border Grid.Row="1" Background="{DynamicResource ThBrBgSurface}"
                        BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="0,0,0,1"
                        Padding="22,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock x:Name="TxtQuestionLabel" Text="Question 1"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource ThBrAccentStrong}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtQuestionMarks" Text=" · 10 marks"
                                       FontSize="12.5" Foreground="{DynamicResource ThBrTextMuted}"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource ThBrBgSurface2}" CornerRadius="999"
                                    Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatusLang" Text="python" FontSize="11"
                                           FontFamily="/Assets/Fonts/#Geist Mono"
                                           Foreground="{DynamicResource ThBrTextSecondary}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtQuestionText" Text="Write a program that…"
                                   FontSize="14" Foreground="{DynamicResource ThBrTextPrimary}"
                                   TextWrapping="Wrap" LineHeight="21" MaxWidth="900" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Editor (Monaco via WebView2) -->
                <wv2:WebView2 Grid.Row="2" x:Name="Editor" DefaultBackgroundColor="#0A0D12"/>

                <!-- Run bar -->
                <Border Grid.Row="3" Background="{DynamicResource ThBrBgSurface}"
                        BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="0,1,0,0" Padding="16,7">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnRun" Style="{StaticResource BtnGhost}" Padding="13,7" Click="BtnRun_Click"
                                    Background="{DynamicResource ThBrSuccessSoft}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" FontSize="10" Foreground="{DynamicResource ThBrSuccess}"
                                               Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Run code" FontSize="12.5" FontWeight="Medium"
                                               Foreground="{DynamicResource ThBrSuccess}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnGhost}" Padding="12,7" Click="BtnClearOutput_Click" Margin="6,0,0,0">
                                <TextBlock Text="Clear" FontSize="12.5" Foreground="{DynamicResource ThBrTextSecondary}"/>
                            </Button>
                            <TextBlock x:Name="TxtExecTime" Text="" FontSize="11.5"
                                       FontFamily="/Assets/Fonts/#Geist Mono"
                                       Foreground="{DynamicResource ThBrTextMuted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Ctrl+Enter to run" FontSize="11.5" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource ThBrTextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Output panel (collapsible) -->
                <Border Grid.Row="4" x:Name="OutputPanel"
                        Background="{DynamicResource ThBrCodeBg}" BorderBrush="{DynamicResource ThBrBorder}"
                        BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <Grid>
                        <ScrollViewer x:Name="OutputTextScroll" MaxHeight="190"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtOutput" Text="" FontSize="12.5"
                                       FontFamily="/Assets/Fonts/#Geist Mono, Consolas"
                                       Foreground="{DynamicResource ThBrCodeText}"
                                       Background="Transparent" TextWrapping="NoWrap" Padding="18,12"/>
                        </ScrollViewer>
                        <wv2:WebView2 x:Name="PreviewWeb" Height="300" Visibility="Collapsed"
                                      DefaultBackgroundColor="White"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════ SUBMISSION OVERLAY (hidden by default) ══════════ -->
        <Border x:Name="SubmissionOverlay"
                Background="#EA0A0D12" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource ThBrBgSurface}" CornerRadius="16"
                    BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1"
                    Padding="48,40" MaxWidth="480" MaxHeight="340"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtSubmitIcon" Text="📤" FontSize="40"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="TxtSubmitStatus" Text="Submitting your exam…"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource ThBrTextPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtSubmitDetail" Text="Please wait while we upload your answers."
                               FontSize="13" Foreground="{DynamicResource ThBrTextSecondary}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,24"/>
                    <Button x:Name="BtnRetry" Content="🔄  Retry Now" Visibility="Collapsed"
                            Click="BtnRetry_Click" FontSize="14" FontWeight="Medium"
                            Foreground="White" Cursor="Hand" HorizontalAlignment="Center" Padding="28,12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="RetryBd" Background="{DynamicResource ThBrAccent}"
                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RetryBd" Property="Background" Value="{DynamicResource ThBrAccentStrong}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="RetryBd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
