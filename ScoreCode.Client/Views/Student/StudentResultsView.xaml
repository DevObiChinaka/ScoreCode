<UserControl x:Class="ScoreCode.Client.Views.Student.StudentResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThBrBgBase}" FontFamily="/Assets/Fonts/#Geist">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14*" MaxWidth="1000"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Margin="8,40,8,48">

                <!-- Header -->
                <TextBlock Text="My Results" FontSize="29" FontWeight="Medium"
                           Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,6"/>
                <TextBlock Text="Graded exams your lecturer has released"
                           FontSize="14.5" Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,26"/>

                <!-- Performance summary (built in code-behind) -->
                <StackPanel x:Name="SummaryHost"/>

                <!-- Section label + sort control -->
                <Grid x:Name="ListHeader" Margin="0,30,0,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ALL RESULTS" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource ThBrTextMuted}"/>
                    <Border Grid.Column="1" CornerRadius="11" Padding="3"
                            Background="{DynamicResource ThBrBgInput}"
                            BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1">
                        <StackPanel x:Name="SortBar" Orientation="Horizontal"/>
                    </Border>
                </Grid>

                <!-- Loading -->
                <TextBlock x:Name="TxtLoading" Text="Loading results…"
                           FontSize="14" Foreground="{DynamicResource ThBrTextMuted}"
                           HorizontalAlignment="Center" Margin="0,60"/>

                <!-- Empty -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,70" Visibility="Collapsed">
                    <TextBlock Text="No results available yet" FontSize="16" FontWeight="Medium"
                               Foreground="{DynamicResource ThBrTextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Results appear here once your lecturer releases them"
                               FontSize="13" Foreground="{DynamicResource ThBrTextMuted}"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Results list -->
                <StackPanel x:Name="ResultsList"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
