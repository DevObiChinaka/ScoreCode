<UserControl x:Class="ScoreCode.Client.Views.Student.StudentResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThBrBgBase}" FontFamily="/Assets/Fonts/#Geist">

    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgBase"        Color="{DynamicResource ThBgBase}"/>
            <SolidColorBrush x:Key="BgCard"        Color="{DynamicResource ThBgPanel}"/>
            <SolidColorBrush x:Key="BgSurface"     Color="{DynamicResource ThBgSurface}"/>
            <SolidColorBrush x:Key="Teal"          Color="{DynamicResource ThAccent}"/>
            <SolidColorBrush x:Key="TextPrimary"   Color="{DynamicResource ThTextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ThTextSecondary}"/>
            <SolidColorBrush x:Key="TextMuted"     Color="{DynamicResource ThTextMuted}"/>
            <SolidColorBrush x:Key="BorderLine"    Color="{DynamicResource ThBorder}"/>
            <SolidColorBrush x:Key="Orange"        Color="{DynamicResource ThWarning}"/>
            <SolidColorBrush x:Key="Purple"        Color="#A78BFA"/>
            <SolidColorBrush x:Key="Green"         Color="{DynamicResource ThSuccess}"/>
            <SolidColorBrush x:Key="Red"           Color="{DynamicResource ThError}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- ── Header ── -->
            <TextBlock Text="My Results" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
            <TextBlock Text="View your graded exam results below." FontSize="13"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24"/>

            <!-- ── Loading indicator ── -->
            <TextBlock x:Name="TxtLoading" Text="Loading results..."
                       FontSize="13" Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center" Margin="0,40"
                       Visibility="Visible"/>

            <!-- ── Empty state ── -->
            <Border x:Name="EmptyState" Visibility="Collapsed"
                    Background="{StaticResource BgCard}" CornerRadius="10"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="1"
                    Padding="32,40">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="No results available yet" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Results will appear here once your lecturer releases them."
                               FontSize="13" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Results list ── -->
            <StackPanel x:Name="ResultsList"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
