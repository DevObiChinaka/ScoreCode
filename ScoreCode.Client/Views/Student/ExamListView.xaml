<UserControl x:Class="ScoreCode.Client.Views.Student.ExamListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThBrBgBase}"
             FontFamily="/Assets/Fonts/#Geist">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14*" MaxWidth="1000"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" Margin="8,40,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="Auto"/>   <!-- toolbar -->
                <RowDefinition Height="*"/>       <!-- list -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="My Exams" FontSize="29" FontWeight="Medium"
                           Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtSubtitle" Text="Exams assigned to you by your lecturers"
                           FontSize="14.5" Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,22"/>
            </StackPanel>

            <!-- Toolbar: search + filters -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Height="40" CornerRadius="10"
                        Background="{DynamicResource ThBrBgInput}"
                        BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1"
                        MaxWidth="360" HorizontalAlignment="Left">
                    <Grid>
                        <Path Data="{StaticResource Icon.Search}" Stroke="{DynamicResource ThBrTextMuted}"
                              StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ThBrTextPrimary}"
                                 CaretBrush="{DynamicResource ThBrAccent}"
                                 VerticalContentAlignment="Center" FontSize="13.5"
                                 Padding="34,0,12,0"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Search exams…"
                                   Foreground="{DynamicResource ThBrTextMuted}" FontSize="13.5"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="35,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Filter segmented control (built in code-behind) -->
                <StackPanel x:Name="FilterBar" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- List area -->
            <Grid Grid.Row="2">
                <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="ListPanel" Margin="0,0,0,40"/>
                </ScrollViewer>

                <TextBlock x:Name="TxtLoading" Text="Loading exams…"
                           FontSize="14" Foreground="{DynamicResource ThBrTextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"/>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,70,0,0" Visibility="Collapsed">
                    <Path Data="{StaticResource Icon.FileText}" Stroke="{DynamicResource ThBrTextMuted}"
                          StrokeThickness="1.5" Width="44" Height="44" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock x:Name="EmptyTitle" Text="No exams assigned yet" FontSize="16" FontWeight="Medium"
                               Foreground="{DynamicResource ThBrTextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptySubtitle" Text="Check back when your lecturer publishes an exam"
                               FontSize="13" Foreground="{DynamicResource ThBrTextMuted}" HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
