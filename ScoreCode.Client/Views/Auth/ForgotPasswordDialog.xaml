<Window x:Class="ScoreCode.Client.Views.Auth.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset password" Height="560" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ThBrBgBase}"
        FontFamily="/Assets/Fonts/#Geist">

    <Window.Resources>
        <!-- Input TextBox (matches the sign-in screen) -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"               Value="{DynamicResource ThBrBgInput}"/>
            <Setter Property="Foreground"               Value="{DynamicResource ThBrTextPrimary}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource ThBrBorder}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="Height"                   Value="46"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource ThBrAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource ThBrTextMuted}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThBrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPw" TargetType="PasswordBox">
            <Setter Property="Background"      Value="{DynamicResource ThBrBgInput}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThBrTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="PasswordChar"    Value="•"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource ThBrAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThBrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ThBrAccent}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThBrTextOnAccent}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThBrAccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThBrBgSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThBrTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource ThBrTextSecondary}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Padding="28,26">
        <StackPanel>
            <TextBlock Text="Reset password" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,6"/>

            <!-- STEP 1 — request -->
            <StackPanel x:Name="RequestStep">
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                           Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,18">
                    Enter your ID number. If an email is on file we'll send you a 6-digit code.
                    Otherwise your administrator will be asked to reset it for you.
                </TextBlock>

                <TextBlock Text="ID Number" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtId" Style="{StaticResource Input}" Tag="e.g. ADUN/FS/SEN/22/003" Margin="0,0,0,18"/>

                <Button x:Name="BtnRequest" Content="Send code" Style="{StaticResource BtnPrimary}"
                        Click="BtnRequest_Click"/>
            </StackPanel>

            <!-- STEP 2 — verify + set new password -->
            <StackPanel x:Name="VerifyStep" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                           Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,18">
                    If an email is on file, a 6-digit code is on its way. Enter it below with a new
                    password. No email? Your administrator will reset it instead.
                </TextBlock>

                <TextBlock Text="Reset Code" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtCode" Style="{StaticResource Input}" Tag="6-digit code" MaxLength="6" Margin="0,0,0,14"/>

                <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PbNew" Style="{StaticResource InputPw}"
                             PasswordChanged="PbNew_PasswordChanged" Margin="0,0,0,10"/>

                <StackPanel x:Name="CritPanel" Margin="0,0,0,14"/>

                <Button x:Name="BtnReset" Content="Reset password" Style="{StaticResource BtnPrimary}"
                        Click="BtnReset_Click" Margin="0,0,0,10"/>
                <Button x:Name="BtnResend" Content="Resend code" HorizontalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{DynamicResource ThBrAccent}" FontSize="13" Click="BtnRequest_Click"/>
            </StackPanel>

            <!-- DONE -->
            <StackPanel x:Name="DoneStep" Visibility="Collapsed">
                <TextBlock Text="Password updated." FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThBrSuccess}" Margin="0,4,0,6"/>
                <TextBlock Text="You can now sign in with your new password." TextWrapping="Wrap"
                           FontSize="13" Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,18"/>
                <Button Content="Back to sign in" Style="{StaticResource BtnPrimary}" Click="BtnClose_Click"/>
            </StackPanel>

            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="13"
                       Margin="0,14,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
