<UserControl x:Class="ScoreCode.Client.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThBrBgBase}"
             FontFamily="/Assets/Fonts/#Geist">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CodeKw"        Color="#00CDB7"/>
        <SolidColorBrush x:Key="CodeFn"        Color="#61AFEF"/>
        <SolidColorBrush x:Key="CodeStr"       Color="#98C379"/>
        <SolidColorBrush x:Key="CodeCmt"       Color="#2D3E5B"/>
        <SolidColorBrush x:Key="ErrorBg"       Color="#1A0A0A"/>

        <!-- Input TextBox -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"               Value="{DynamicResource ThBrBgInput}"/>
            <Setter Property="Foreground"               Value="{DynamicResource ThBrTextPrimary}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource ThBrBorder}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="Height"                   Value="46"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource ThBrAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource ThBrTextMuted}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThBrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox -->
        <Style x:Key="InputPw" TargetType="PasswordBox">
            <Setter Property="Background"      Value="{DynamicResource ThBrBgInput}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThBrTextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource ThBrAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="PasswordPlaceholder" Text="Password"
                                           Foreground="{DynamicResource ThBrTextMuted}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThBrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary teal button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ThBrAccent}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThBrTextOnAccent}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThBrAccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThBrBgSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThBrTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost link -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ═══════════ CONTENT — no manual title bar ═══════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.45*"/>
            <ColumnDefinition Width="0.55*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT PANEL ── -->
        <Border Grid.Column="0" Background="{DynamicResource ThBrBgPanel}">
            <Grid>
                <!-- Dot wallpaper -->
                <Border>
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" ViewportUnits="Absolute"
                                      Viewport="0,0,30,30" Opacity="0.035">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="White">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry RadiusX="1.4" RadiusY="1.4" Center="15,15"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                </Border>

                <!-- Teal accent left edge -->
                <Border HorizontalAlignment="Left" Width="3" Background="{DynamicResource ThBrAccent}" Opacity="0.7"/>

                <Grid Margin="36,0,36,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LIVE GRADING PREVIEW"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThBrTextMuted}"/>

                    <!-- Code card -->
                    <Border Grid.Row="2" Background="{DynamicResource ThBrBgSurface}"
                            BorderBrush="{DynamicResource ThBrBorder}"
                            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <StackPanel>
                            <Border Height="3" Background="{DynamicResource ThBrAccent}" Opacity="0.6"/>
                            <Border Background="{DynamicResource ThBrBgSurface}" BorderBrush="{DynamicResource ThBrBorder}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Padding="14,8" Background="{DynamicResource ThBrBgSurface}">
                                        <TextBlock Text="submission.py" FontSize="11"
                                                   Foreground="{DynamicResource ThBrAccent}"/>
                                    </Border>
                                    <Border Padding="14,8" Background="Transparent">
                                        <TextBlock Text="result.json" FontSize="11"
                                                   Foreground="{DynamicResource ThBrTextMuted}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Grid Margin="16,14,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="1"  FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{StaticResource CodeCmt}" LineHeight="22"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="2"  FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{StaticResource CodeCmt}" LineHeight="22"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="3"  FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{StaticResource CodeCmt}" LineHeight="22"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="4"  FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{StaticResource CodeCmt}" LineHeight="22"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="5"  FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{StaticResource CodeCmt}" LineHeight="22"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="6"  FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{StaticResource CodeCmt}" LineHeight="22"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="7"  FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{StaticResource CodeCmt}" LineHeight="22"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="8"  FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{StaticResource CodeCmt}" LineHeight="22"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" LineHeight="22">
                                    <Run Foreground="{StaticResource CodeKw}" Text="def "/><Run Foreground="{StaticResource CodeFn}" Text="evaluate_submission"/><Run Foreground="{DynamicResource ThBrTextPrimary}" Text="(code, guide):"/>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" LineHeight="22">
                                    <Run Foreground="{StaticResource CodeCmt}" Text="    # AI-assisted grading engine"/>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" LineHeight="22">
                                    <Run Foreground="{DynamicResource ThBrTextPrimary}" Text="    prompt = "/><Run Foreground="{StaticResource CodeFn}" Text="build_prompt"/><Run Foreground="{DynamicResource ThBrTextPrimary}" Text="("/>
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" LineHeight="22">
                                    <Run Foreground="{DynamicResource ThBrTextPrimary}" Text="        question="/><Run Foreground="{StaticResource CodeStr}" Text="guide.text"/><Run Foreground="{DynamicResource ThBrTextPrimary}" Text=","/>
                                </TextBlock>
                                <TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" LineHeight="22">
                                    <Run Foreground="{DynamicResource ThBrTextPrimary}" Text="        criteria="/><Run Foreground="{StaticResource CodeStr}" Text="guide.marking_guide"/><Run Foreground="{DynamicResource ThBrTextPrimary}" Text=","/>
                                </TextBlock>
                                <TextBlock Grid.Row="5" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" LineHeight="22">
                                    <Run Foreground="{DynamicResource ThBrTextPrimary}" Text="        student_code="/><Run Foreground="{StaticResource CodeStr}" Text="code"/>
                                </TextBlock>
                                <TextBlock Grid.Row="6" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" LineHeight="22">
                                    <Run Foreground="{DynamicResource ThBrTextPrimary}" Text="    )"/>
                                </TextBlock>
                                <TextBlock Grid.Row="7" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" LineHeight="22">
                                    <Run Foreground="{StaticResource CodeKw}" Text="    return "/><Run Foreground="{StaticResource CodeFn}" Text="claude"/><Run Foreground="{DynamicResource ThBrTextPrimary}" Text="."/><Run Foreground="{StaticResource CodeKw}" Text="grade"/><Run Foreground="{DynamicResource ThBrTextPrimary}" Text="(prompt)"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Status + Grade chips -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource ThBrBgSurface}"
                                BorderBrush="{DynamicResource ThBrBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="STATUS" FontSize="9" FontWeight="Medium"
                                           Foreground="{DynamicResource ThBrTextMuted}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource ThBrAccent}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Submitted" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource ThBrTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="01:24:11" FontSize="11"
                                           Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource ThBrBgSurface}"
                                BorderBrush="{DynamicResource ThBrBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="GRADE" FontSize="9" FontWeight="Medium"
                                           Foreground="{DynamicResource ThBrTextMuted}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="17" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource ThBrAccent}" LineHeight="28"/>
                                    <TextBlock Text=" /20" FontSize="13"
                                               Foreground="{DynamicResource ThBrTextSecondary}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </StackPanel>
                                <TextBlock Text="+3 criteria matched" FontSize="11"
                                           Foreground="{StaticResource CodeStr}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Runtime -->
                    <Border Grid.Row="6" Background="{DynamicResource ThBrBgSurface}"
                            BorderBrush="{DynamicResource ThBrBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#E6C84A"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock FontSize="13" Foreground="{DynamicResource ThBrTextSecondary}">
                                <Run Text="Python 3.12 " Foreground="{DynamicResource ThBrTextPrimary}" FontWeight="Medium"/>
                                <Run Text="·  sandboxed"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ── RIGHT PANEL ── -->
        <Border Grid.Column="1" Background="{DynamicResource ThBrBgBase}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <!-- Form centred -->
                <Grid Grid.Row="0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="360">

                        <!-- Logo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                            <Border Width="26" Height="26" CornerRadius="6"
                                    Background="{DynamicResource ThBrAccent}" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#0D1117" Width="5" Height="5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#0D1117" Width="5" Height="5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#0D1117" Width="5" Height="5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#0D1117" Width="5" Height="5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="ScoreCode" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThBrTextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Hello," FontSize="34" FontWeight="Bold"
                                   Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,2"/>
                        <TextBlock Text="Welcome back." FontSize="34" FontWeight="Bold"
                                   Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock Text="Sign in to your exam portal."
                                   FontSize="14" Foreground="{DynamicResource ThBrTextSecondary}"
                                   Margin="0,0,0,30"/>

                        <!-- ID field -->
                        <TextBlock Text="ID Number" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtIdNumber" Style="{StaticResource Input}"
                                 Tag="Matric no., Staff ID or Admin ID"
                                 Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <!-- Password field -->
                        <TextBlock Text="Password" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="PbPassword" Style="{StaticResource InputPw}"
                                     PasswordChanged="PbPassword_PasswordChanged"
                                     Margin="0,0,0,24"/>

                        <!-- Error -->
                        <Border Background="{StaticResource ErrorBg}"
                                BorderBrush="#3D1010" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                                Visibility="{Binding HasError,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource ThBrError}"
                                       FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Sign in -->
                        <Button Style="{StaticResource BtnPrimary}"
                                Click="BtnLogin_Click"
                                IsEnabled="{Binding IsLoading,
                                    Converter={StaticResource InverseBoolConverter}}"
                                Margin="0,0,0,22">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Visibility="{Binding IsLoading,
                                    Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <Run Text="Sign in  "/><Run Text="→"/>
                                </TextBlock>
                                <TextBlock Text="Signing in…"
                                           Visibility="{Binding IsLoading,
                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="New student?  " FontSize="13"
                                       Foreground="{DynamicResource ThBrTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource BtnGhost}" Click="BtnRegister_Click">
                                <TextBlock Text="Create account" FontSize="13"
                                           Foreground="{DynamicResource ThBrAccent}"
                                           TextDecorations="Underline"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Admiralty University of Nigeria  ·  Secure environment"
                           Foreground="{DynamicResource ThBrTextMuted}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
