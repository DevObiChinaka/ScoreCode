<Window x:Class="ScoreCode.Client.Views.DashboardShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThBrBgBase}"
        FontFamily="/Assets/Fonts/#Geist">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Colours — aliased to theme -->
            <SolidColorBrush x:Key="BgBase"        Color="{DynamicResource ThBgBase}"/>
            <SolidColorBrush x:Key="BgSidebar"     Color="{DynamicResource ThBgSidebar}"/>
            <SolidColorBrush x:Key="BgSurface"     Color="{DynamicResource ThBgSurface}"/>
            <SolidColorBrush x:Key="BgHover"       Color="{DynamicResource ThBgHover}"/>
            <SolidColorBrush x:Key="Teal"          Color="{DynamicResource ThAccent}"/>
            <SolidColorBrush x:Key="TextPrimary"   Color="{DynamicResource ThTextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ThTextSecondary}"/>
            <SolidColorBrush x:Key="TextMuted"     Color="{DynamicResource ThTextMuted}"/>
            <SolidColorBrush x:Key="BorderLine"    Color="{DynamicResource ThBorder}"/>

            <!-- Sidebar nav button style -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0" Padding="0">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sign-out ghost button -->
            <Style x:Key="BtnGhost" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar — width animated by code-behind -->
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <!-- Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ SIDEBAR ══════════ -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Logo + collapse -->
                    <RowDefinition Height="*"/>       <!-- Nav items -->
                    <RowDefinition Height="Auto"/>   <!-- User card -->
                </Grid.RowDefinitions>

                <!-- ── Logo + Collapse toggle ── -->
                <Grid Grid.Row="0" Margin="0,12,0,8">
                    <!-- Logo (visible when expanded) -->
                    <StackPanel x:Name="LogoFull" Orientation="Horizontal" Margin="16,0,0,0">
                        <Border Width="28" Height="28" CornerRadius="6"
                                Background="{StaticResource Teal}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="#0D1117" Width="6" Height="6" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Row="0" Grid.Column="1" Background="#0D1117" Width="6" Height="6" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Grid.Column="0" Background="#0D1117" Width="6" Height="6" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Grid.Column="1" Background="#0D1117" Width="6" Height="6" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="ScoreCode" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Collapse button -->
                    <Button x:Name="BtnCollapse" Style="{StaticResource BtnGhost}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="8,6" Margin="0,0,8,0"
                            Click="BtnCollapse_Click">
                        <Path x:Name="CollapseIcon" Data="{StaticResource Icon.PanelClose}"
                              Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Separator -->
                <Border Grid.Row="0" VerticalAlignment="Bottom"
                        Height="1" Background="{StaticResource BorderLine}" Margin="12,0"/>

                <!-- ── Navigation items ── -->
                <ItemsControl x:Name="NavList" Grid.Row="1" Margin="0,8,0,0">
                    <!-- Items populated from code-behind -->
                </ItemsControl>

                <!-- ── User profile card ── -->
                <Border Grid.Row="2" Background="{StaticResource BgSurface}"
                        CornerRadius="8" Margin="10,8,10,12" Padding="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Initials circle -->
                            <Border Grid.Column="0" Grid.RowSpan="2"
                                    Width="36" Height="36" CornerRadius="18"
                                    Background="{StaticResource Teal}"
                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtInitials" Text="SC"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#0D1117"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- ID + Role -->
                            <TextBlock x:Name="TxtUserId" Grid.Column="1" Grid.Row="0"
                                       Text="CSC/2021/001" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtUserRole" Grid.Column="1" Grid.Row="1"
                                       Text="Student" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderLine}" Margin="0,8,0,6"/>

                        <!-- Sign out button -->
                        <Button x:Name="BtnSignOut" Style="{StaticResource BtnGhost}"
                                HorizontalAlignment="Stretch"
                                Padding="6,5" Click="BtnSignOut_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource Icon.LogOut}"
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtSignOut" Text="Sign Out" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════ CONTENT AREA ══════════ -->
        <ContentControl x:Name="ContentHost" Grid.Column="1"
                        Background="{StaticResource BgBase}"/>
    </Grid>
</Window>
