<UserControl x:Class="ScoreCode.Client.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThBrBgBase}"
             FontFamily="/Assets/Fonts/#Geist">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- Header -->
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,4"/>
            <TextBlock Text="Manage your profile, preferences, and account"
                       FontSize="13" Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,28"/>

            <!-- ── Section: Profile ── -->
            <StackPanel x:Name="ProfileSection"/>

            <!-- ── Section: Appearance ── -->
            <StackPanel x:Name="AppearanceSection" Margin="0,20,0,0"/>

            <!-- ── Section: Change Password ── -->
            <StackPanel x:Name="PasswordSection" Margin="0,20,0,0"/>

            <!-- ── Section: Default Exam Settings (lecturer only) ── -->
            <StackPanel x:Name="ExamDefaultsSection" Margin="0,20,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
