<UserControl x:Class="ScoreCode.Client.Views.Lecturer.ExamEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThBrBgBase}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Border"       Color="{DynamicResource ThBorder}"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThBrAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThBrTextOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/#Geist"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/#Geist"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- Lock banner -->
            <RowDefinition Height="Auto"/>  <!-- Metadata form -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button DockPanel.Dock="Left" Content="Back"
                    Background="Transparent" Foreground="{DynamicResource ThBrTextSecondary}"
                    FontSize="13" FontFamily="/Assets/Fonts/#Geist"
                    BorderThickness="0" Cursor="Hand" Padding="0,4"
                    VerticalAlignment="Center"
                    Click="BtnBack_Click"/>
            <TextBlock x:Name="TxtTitle" DockPanel.Dock="Left"
                       FontSize="20" FontWeight="Bold" Margin="16,0,0,0"
                       Foreground="{DynamicResource ThBrTextPrimary}"
                       FontFamily="/Assets/Fonts/#Geist"/>
        </DockPanel>

        <!-- LOCK BANNER (non-Draft exams) -->
        <Border x:Name="LockBanner" Grid.Row="1" Visibility="Collapsed"
                Background="#1B2D2D" CornerRadius="8" Padding="16,10"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtLockMsg" Text="Editing is disabled — this exam is no longer in Draft."
                           FontSize="12" Foreground="#F6AD55"
                           FontFamily="/Assets/Fonts/#Geist" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- EXAM METADATA FORM -->
        <Border x:Name="MetadataPanel" Grid.Row="2" Background="{DynamicResource ThBrBgPanel}"
                CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1"
                Padding="20,16" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Exam Details" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThBrTextPrimary}"
                               FontFamily="/Assets/Fonts/#Geist" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtStatusBadge" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="BtnSaveExam" Content="Save Changes"
                                Style="{StaticResource ActionBtn}"
                                Click="BtnSaveExam_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Title" FontSize="11" Foreground="{DynamicResource ThBrTextSecondary}"
                                   FontFamily="/Assets/Fonts/#Geist" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtExamTitle" FontSize="13" Height="36"
                                 FontFamily="/Assets/Fonts/#Geist"
                                 Background="{DynamicResource ThBrBgInput}"
                                 Foreground="{DynamicResource ThBrTextPrimary}"
                                 BorderBrush="{StaticResource Border}"
                                 Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="Course Code" FontSize="11" Foreground="{DynamicResource ThBrTextSecondary}"
                                   FontFamily="/Assets/Fonts/#Geist" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtExamCode" FontSize="13" Height="36"
                                 FontFamily="/Assets/Fonts/#Geist"
                                 Background="{DynamicResource ThBrBgInput}"
                                 Foreground="{DynamicResource ThBrTextPrimary}"
                                 BorderBrush="{StaticResource Border}"
                                 Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Grid.Row="0">
                        <TextBlock Text="Scheduled Date &amp; Time" FontSize="11" Foreground="{DynamicResource ThBrTextSecondary}"
                                   FontFamily="/Assets/Fonts/#Geist" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtExamDate" FontSize="13" Height="36"
                                 FontFamily="/Assets/Fonts/#Geist"
                                 Background="{DynamicResource ThBrBgInput}"
                                 Foreground="{DynamicResource ThBrTextPrimary}"
                                 BorderBrush="{StaticResource Border}"
                                 Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Row 1 -->
                    <StackPanel Grid.Column="0" Grid.Row="1">
                        <TextBlock Text="Duration (min)" FontSize="11" Foreground="{DynamicResource ThBrTextSecondary}"
                                   FontFamily="/Assets/Fonts/#Geist" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtExamDuration" FontSize="13" Height="36"
                                 FontFamily="/Assets/Fonts/#Geist"
                                 Background="{DynamicResource ThBrBgInput}"
                                 Foreground="{DynamicResource ThBrTextPrimary}"
                                 BorderBrush="{StaticResource Border}"
                                 Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1">
                        <TextBlock Text="Languages" FontSize="11" Foreground="{DynamicResource ThBrTextSecondary}"
                                   FontFamily="/Assets/Fonts/#Geist" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtExamLangs" FontSize="13" Height="36"
                                 FontFamily="/Assets/Fonts/#Geist"
                                 Background="{DynamicResource ThBrBgInput}"
                                 Foreground="{DynamicResource ThBrTextPrimary}"
                                 BorderBrush="{StaticResource Border}"
                                 Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Grid.Row="1">
                        <CheckBox x:Name="ChkIntelli" Content="Enable IntelliSense"
                                  Foreground="{DynamicResource ThBrTextPrimary}"
                                  FontFamily="/Assets/Fonts/#Geist" FontSize="12"
                                  Margin="0,18,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- TWO-COLUMN LAYOUT -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Questions -->
            <Border Grid.Column="0" Background="{DynamicResource ThBrBgPanel}"
                    CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- LastChildFill=False so the Add button keeps its natural
                         size on the right instead of stretching across. -->
                    <DockPanel Grid.Row="0" Margin="16,14,16,14" LastChildFill="False">
                        <TextBlock Text="Questions" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextPrimary}"
                                   FontFamily="/Assets/Fonts/#Geist" DockPanel.Dock="Left"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnAddQuestion" DockPanel.Dock="Right" Content="+ Add"
                                Style="{StaticResource ActionBtn}" Padding="14,7"
                                Click="BtnAddQuestion_Click"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="QuestionList" Margin="16,0,16,16"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: Students -->
            <Border Grid.Column="2" Background="{DynamicResource ThBrBgPanel}"
                    CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,14,16,14">
                        <TextBlock Text="Assigned Students" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextPrimary}"
                                   FontFamily="/Assets/Fonts/#Geist" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtStudentCount" DockPanel.Dock="Right"
                                   FontSize="12" Foreground="{DynamicResource ThBrTextMuted}"
                                   FontFamily="/Assets/Fonts/#Geist" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Button x:Name="BtnAssignStudents" Grid.Row="1" Content="+ Assign Students"
                            Style="{StaticResource ActionBtn}" Margin="16,0,16,12"
                            Click="BtnAssignStudents_Click"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StudentList" Margin="16,0,16,16"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
