<UserControl x:Class="ScoreCode.Client.Views.Lecturer.ExamManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThBrBgBase}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThBrAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThBrTextOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/#Geist"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThBrAccentDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/#Geist"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="/Assets/Fonts/#Geist"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PBd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PBd" Property="Background" Value="{DynamicResource ThBrBgSurface}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PBd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Search + filter bar -->
            <RowDefinition Height="*"/>      <!-- Exam cards -->
            <RowDefinition Height="Auto"/>   <!-- Pagination -->
            <RowDefinition Height="Auto"/>   <!-- Status -->
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top"
                    Click="BtnCreateExam_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NeBd" Background="{DynamicResource ThBrAccent}"
                                CornerRadius="6" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Plus}"
                                      Stroke="{DynamicResource ThBrTextOnAccent}"
                                      StrokeThickness="2" Width="14" Height="14"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="New Exam" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThBrTextOnAccent}"
                                           FontFamily="/Assets/Fonts/#Geist"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NeBd" Property="Background" Value="{DynamicResource ThBrAccentDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <StackPanel>
                <TextBlock Text="Manage Exams"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource ThBrTextPrimary}"
                           FontFamily="/Assets/Fonts/#Geist"/>
                <TextBlock Text="Create exams, add questions, assign students"
                           FontSize="13" Foreground="{DynamicResource ThBrTextSecondary}"
                           FontFamily="/Assets/Fonts/#Geist" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- SEARCH + FILTER BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <Border Grid.Column="0" Background="{DynamicResource ThBrBgInput}"
                    BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="12,0" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource Icon.Search}"
                          Stroke="{DynamicResource ThBrTextMuted}" StrokeThickness="2"
                          Width="14" Height="14" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1"
                             Height="36" FontSize="13"
                             FontFamily="/Assets/Fonts/#Geist"
                             Background="Transparent"
                             Foreground="{DynamicResource ThBrTextPrimary}"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_Changed"/>
                </Grid>
            </Border>

            <!-- Filter buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnAll" Content="All" Style="{StaticResource SmallBtn}"
                        Background="{DynamicResource ThBrAccent}"
                        Foreground="{DynamicResource ThBrTextOnAccent}"
                        Margin="0,0,4,0" Click="FilterBtn_Click" Tag="All"/>
                <Button x:Name="BtnDraft" Content="Draft" Style="{StaticResource SmallBtn}"
                        Background="{DynamicResource ThBrBgSurface}"
                        Foreground="{DynamicResource ThBrTextSecondary}"
                        Margin="0,0,4,0" Click="FilterBtn_Click" Tag="Draft"/>
                <Button x:Name="BtnActive" Content="Active" Style="{StaticResource SmallBtn}"
                        Background="{DynamicResource ThBrBgSurface}"
                        Foreground="{DynamicResource ThBrTextSecondary}"
                        Margin="0,0,4,0" Click="FilterBtn_Click" Tag="Active"/>
                <Button x:Name="BtnClosed" Content="Closed" Style="{StaticResource SmallBtn}"
                        Background="{DynamicResource ThBrBgSurface}"
                        Foreground="{DynamicResource ThBrTextSecondary}"
                        Click="FilterBtn_Click" Tag="Closed"/>
            </StackPanel>
        </Grid>

        <!-- LOADING -->
        <TextBlock x:Name="TxtLoading" Grid.Row="2"
                   Text="Loading exams…" FontSize="14"
                   Foreground="{DynamicResource ThBrTextSecondary}"
                   FontFamily="/Assets/Fonts/#Geist"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- EXAM TABLE -->
        <Border Grid.Row="2" x:Name="ExamTable" Visibility="Collapsed"
                Background="{DynamicResource ThBrBgPanel}" CornerRadius="8"
                BorderBrush="{DynamicResource ThBrBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table header -->
                <Border Grid.Row="0" Background="{DynamicResource ThBrBgSurface}"
                        CornerRadius="8,8,0,0" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>   <!-- Title -->
                            <ColumnDefinition Width="1.2*"/>   <!-- Course -->
                            <ColumnDefinition Width="1.2*"/>   <!-- Date -->
                            <ColumnDefinition Width="0.8*"/>   <!-- Status -->
                            <ColumnDefinition Width="0.6*"/>   <!-- Questions -->
                            <ColumnDefinition Width="0.6*"/>   <!-- Students -->
                            <ColumnDefinition Width="1.2*"/>   <!-- Actions -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="EXAM" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextMuted}" FontFamily="/Assets/Fonts/#Geist"/>
                        <TextBlock Grid.Column="1" Text="COURSE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextMuted}" FontFamily="/Assets/Fonts/#Geist"/>
                        <TextBlock Grid.Column="2" Text="SCHEDULED" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextMuted}" FontFamily="/Assets/Fonts/#Geist"/>
                        <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextMuted}" FontFamily="/Assets/Fonts/#Geist"/>
                        <TextBlock Grid.Column="4" Text="Q's" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextMuted}" FontFamily="/Assets/Fonts/#Geist"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="STUDENTS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextMuted}" FontFamily="/Assets/Fonts/#Geist"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThBrTextMuted}" FontFamily="/Assets/Fonts/#Geist"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ExamRows" Margin="0,0,0,8"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- EMPTY STATE -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="No exams yet" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource ThBrTextPrimary}"
                       FontFamily="/Assets/Fonts/#Geist" HorizontalAlignment="Center"/>
            <TextBlock Text="Create your first exam to get started"
                       FontSize="13" Foreground="{DynamicResource ThBrTextSecondary}"
                       FontFamily="/Assets/Fonts/#Geist" Margin="0,6,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- PAGINATION -->
        <Border Grid.Row="3" x:Name="PaginationBar" Visibility="Collapsed"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtPageInfo" Grid.Column="0"
                           FontSize="12" Foreground="{DynamicResource ThBrTextSecondary}"
                           FontFamily="/Assets/Fonts/#Geist" VerticalAlignment="Center"/>

                <StackPanel x:Name="PageButtons" Grid.Column="1"
                            Orientation="Horizontal"/>

                <TextBlock x:Name="TxtTotalInfo" Grid.Column="2"
                           FontSize="12" Foreground="{DynamicResource ThBrTextMuted}"
                           FontFamily="/Assets/Fonts/#Geist" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- STATUS -->
        <TextBlock x:Name="TxtStatus" Grid.Row="4" Margin="0,8,0,0"
                   FontSize="12" Foreground="{DynamicResource ThBrTextMuted}"
                   FontFamily="/Assets/Fonts/#Geist"/>
    </Grid>
</UserControl>
