<UserControl x:Class="ScoreCode.Client.Views.Dashboard.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThBrBgBase}" FontFamily="/Assets/Fonts/#Geist">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BgCard"        Color="{DynamicResource ThBgPanel}"/>
            <SolidColorBrush x:Key="BorderLine"    Color="{DynamicResource ThBorder}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Centered, fluid content column (fills up to a max, then centers) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14*" MaxWidth="1080"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Margin="8,40,8,48">

            <!-- ── Header ── -->
            <TextBlock x:Name="TxtEyebrow" Text="TODAY" FontSize="12" FontWeight="Medium"
                       FontFamily="/Assets/Fonts/#Geist Mono, Consolas"
                       Foreground="{DynamicResource ThBrAccentStrong}" Margin="0,0,0,9"/>
            <TextBlock x:Name="TxtWelcome" Text="Welcome back." FontSize="29" FontWeight="Medium"
                       Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,7"/>
            <TextBlock x:Name="TxtSubtitle" FontSize="14.5"
                       Foreground="{DynamicResource ThBrTextSecondary}" Margin="0,0,0,4"/>

            <!-- ── Student layout (built in code-behind) ── -->
            <StackPanel x:Name="StudentRoot" Visibility="Collapsed" Margin="0,24,0,0"/>

            <!-- ── Generic layout (lecturer / admin) ── -->
            <StackPanel x:Name="GenericRoot" Margin="0,24,0,0">

                <UniformGrid x:Name="StatCardsGrid" Rows="1" Margin="0,0,0,30"/>

                <TextBlock x:Name="TxtSection1Title" Text="Upcoming Exams" FontSize="15.5" FontWeight="Medium"
                           Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,12"/>
                <Border Background="{StaticResource BgCard}" CornerRadius="14"
                        BorderBrush="{StaticResource BorderLine}" BorderThickness="1"
                        Padding="20,16" Margin="0,0,0,24">
                    <StackPanel x:Name="Section1Content">
                        <TextBlock Text="No exams scheduled yet."
                                   FontSize="13" Foreground="{DynamicResource ThBrTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,20"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Recent Activity" FontSize="15.5" FontWeight="Medium"
                           Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,12"/>
                <Border Background="{StaticResource BgCard}" CornerRadius="14"
                        BorderBrush="{StaticResource BorderLine}" BorderThickness="1"
                        Padding="20,16" Margin="0,0,0,24">
                    <StackPanel x:Name="Section2Content">
                        <TextBlock Text="No recent activity."
                                   FontSize="13" Foreground="{DynamicResource ThBrTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,20"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Quick Actions" FontSize="15.5" FontWeight="Medium"
                           Foreground="{DynamicResource ThBrTextPrimary}" Margin="0,0,0,12"/>
                <UniformGrid x:Name="QuickActionsGrid" Rows="1" Margin="0,0,0,8"/>

            </StackPanel>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
