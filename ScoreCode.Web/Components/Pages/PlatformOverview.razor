@page "/platform"
@layout DashboardLayout
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav

<div class="pagehead">
    <div><h1>Overview</h1><div class="sub">Platform administration</div></div>
</div>

<div class="stats">
    <div class="stat"><div class="n teal">@_all.Count</div><div class="l">Institutions</div></div>
    <div class="stat"><div class="n">@(_dash?.TotalStudents ?? 0)</div><div class="l">Students</div></div>
    <div class="stat"><div class="n">@(_dash?.TotalLecturers ?? 0)</div><div class="l">Lecturers</div></div>
    <div class="stat"><div class="n">@(_dash?.TotalExams ?? 0)</div><div class="l">Exams</div></div>
    <div class="stat"><div class="n ok">@(_dash?.ActiveExams ?? 0)</div><div class="l">Active exams</div></div>
    <div class="stat"><div class="n">@(_dash?.TotalSubmissions ?? 0)</div><div class="l">Submissions</div></div>
</div>

<div class="metarow">
    <span class="badge pending">@Count("Pending") pending</span>
    <span class="badge approved">@Count("Approved") approved</span>
    @if (Count("Suspended") > 0) { <span class="badge suspended">@Count("Suspended") suspended</span> }
    @if (!string.IsNullOrEmpty(TypeSummary)) { <span class="muted small" style="margin-left:4px">@TypeSummary</span> }
</div>

<div class="section-title">Awaiting approval</div>
@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (!Pending.Any())
{
    <div class="empty" style="padding:40px"><div class="big">All caught up</div>No institutions are awaiting review.</div>
}
else
{
    <div class="tablewrap">
        <table>
            <thead><tr><th>Institution</th><th>Type</th><th>Contact</th><th>Submitted</th><th></th></tr></thead>
            <tbody>
                @foreach (var i in Pending.OrderBy(i => i.CreatedAt))
                {
                    <tr>
                        <td><a href="/platform/institutions/@i.Id" class="primary">@i.Name</a><div class="mono">@i.Prefix</div></td>
                        <td>@i.Type</td>
                        <td>@(string.IsNullOrWhiteSpace(i.ContactPerson) ? "" : i.ContactPerson)<div class="mono">@i.ContactEmail</div></td>
                        <td class="mono">@i.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="row-actions"><a class="btn btn-sm" href="/platform/institutions">Review</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_dash is not null && _dash.TopInstitutions.Any())
{
    <div class="section-title">Most active institutions</div>
    <div class="tablewrap">
        <table>
            <thead><tr><th>Institution</th><th>Type</th><th style="text-align:right">Students</th><th style="text-align:right">Lecturers</th><th style="text-align:right">Exams</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var t in _dash.TopInstitutions)
                {
                    <tr>
                        <td><a href="/platform/institutions/@t.Id">@t.Name</a></td>
                        <td class="muted">@t.Type</td>
                        <td class="mono" style="text-align:right">@t.Students</td>
                        <td class="mono" style="text-align:right">@t.Lecturers</td>
                        <td class="mono" style="text-align:right">@t.Exams</td>
                        <td><span class="badge @t.Status.ToLowerInvariant()">@t.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<InstitutionDto> _all = new();
    private PlatformDashboardDto? _dash;
    private bool _loading = true;

    private IEnumerable<InstitutionDto> Pending => _all.Where(i => i.Status == "Pending");
    private int Count(string s) => _all.Count(i => i.Status == s);

    private string TypeSummary => string.Join("  ·  ", _all
        .GroupBy(i => string.IsNullOrWhiteSpace(i.Type) ? "Other" : i.Type)
        .OrderByDescending(g => g.Count())
        .Select(g => $"{g.Count()} {g.Key}"));

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsPlatformAdmin) { Nav.NavigateTo("/login"); return; }
        _all = await Api.GetInstitutionsAsync(null);
        _dash = await Api.GetPlatformDashboardAsync();
        _loading = false;
    }
}
