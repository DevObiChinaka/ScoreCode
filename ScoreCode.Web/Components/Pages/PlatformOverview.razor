@page "/platform"
@layout DashboardLayout
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav

<div class="pagehead">
    <div><h1>Overview</h1><div class="sub">Platform administration</div></div>
</div>

<div class="stats">
    <div class="stat"><div class="n teal">@_all.Count</div><div class="l">Institutions</div></div>
    <div class="stat"><div class="n warn">@Count("Pending")</div><div class="l">Pending review</div></div>
    <div class="stat"><div class="n">@(_dash?.TotalStudents ?? 0)</div><div class="l">Students</div></div>
    <div class="stat"><div class="n">@(_dash?.TotalLecturers ?? 0)</div><div class="l">Lecturers</div></div>
</div>

<div class="section-title">Awaiting approval</div>
@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (!Pending.Any())
{
    <div class="empty" style="padding:40px"><div class="big">All caught up</div>No institutions are awaiting review.</div>
}
else
{
    <div class="tablewrap">
        <table>
            <thead><tr><th>Institution</th><th>Type</th><th>Contact</th><th>Submitted</th><th></th></tr></thead>
            <tbody>
                @foreach (var i in Pending.OrderBy(i => i.CreatedAt))
                {
                    <tr>
                        <td><a href="/platform/institutions/@i.Id" class="primary">@i.Name</a><div class="mono">@i.Prefix</div></td>
                        <td>@i.Type</td>
                        <td>@(string.IsNullOrWhiteSpace(i.ContactPerson) ? "" : i.ContactPerson)<div class="mono">@i.ContactEmail</div></td>
                        <td class="mono">@i.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="row-actions"><a class="btn btn-sm" href="/platform/institutions">Review</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="section-title">Explore</div>
<div class="quick">
    <a href="/platform/analytics">
        <div class="t">Analytics</div>
        <div class="d">Platform-wide charts: people, institution status, enrolment and activity.</div>
    </a>
    <a href="/platform/institutions">
        <div class="t">Institutions</div>
        <div class="d">Approve, suspend or drill into any registered school.</div>
    </a>
    <a href="/platform/lecturers">
        <div class="t">Lecturers</div>
        <div class="d">Every lecturer across institutions, with password resets.</div>
    </a>
    <a href="/platform/students">
        <div class="t">Students</div>
        <div class="d">Every student across institutions, filterable by school.</div>
    </a>
</div>

@code {
    private List<InstitutionDto> _all = new();
    private PlatformDashboardDto? _dash;
    private bool _loading = true;

    private IEnumerable<InstitutionDto> Pending => _all.Where(i => i.Status == "Pending");
    private int Count(string s) => _all.Count(i => i.Status == s);

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsPlatformAdmin) { Nav.NavigateTo("/login"); return; }
        _all = await Api.GetInstitutionsAsync(null);
        _dash = await Api.GetPlatformDashboardAsync();
        _loading = false;
    }
}
