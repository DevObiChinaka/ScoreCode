@page "/institution"
@layout DashboardLayout
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav

<div class="pagehead">
    <div><h1>Overview</h1><div class="sub">Institution administration</div></div>
</div>

<div class="stats">
    <div class="stat"><div class="n teal">@_lecturers.Count</div><div class="l">Lecturers</div></div>
    <div class="stat"><div class="n">@_students.Count</div><div class="l">Students</div></div>
    <div class="stat"><div class="n ok">@ActiveCount</div><div class="l">Active accounts</div></div>
    <div class="stat"><div class="n warn">@InactiveCount</div><div class="l">Deactivated</div></div>
</div>

@if (_requests.Any())
{
    <div class="section-title">Password reset requests</div>
    <div class="tablewrap">
        <table>
            <thead><tr><th>User</th><th>Role</th><th>Requested</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in _requests)
                {
                    <tr>
                        <td><div class="primary">@(string.IsNullOrWhiteSpace(r.Name) ? r.IdNumber : r.Name)</div><div class="mono">@r.IdNumber</div></td>
                        <td class="muted">@r.Role</td>
                        <td class="mono">@r.RequestedAt.ToLocalTime().ToString("dd MMM, HH:mm")</td>
                        <td class="row-actions"><button class="btn btn-sm" @onclick="() => Resolve(r)">Reset password</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_resetPwd is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h2>Password reset</h2>
            <p class="muted small" style="margin:6px 0 12px">New temporary password for <b>@_resetName</b>. Share it securely — shown only once.</p>
            <label>Temporary password</label>
            <div class="cred">@_resetPwd</div>
            <button class="btn block" style="margin-top:18px" @onclick="() => _resetPwd = null">Done</button>
        </div>
    </div>
}

<div class="grid-2">
    <div>
        <div class="section-title" style="margin-top:8px">Recent lecturers</div>
        @if (!_lecturers.Any())
        {
            <div class="empty" style="padding:36px"><div class="big">No lecturers yet</div>Add your first lecturer.</div>
        }
        else
        {
            <div class="listcard">
                @foreach (var l in _lecturers.Take(5))
                {
                    <div class="listrow">
                        <div class="avatar">@Init(l.Name, l.IdNumber)</div>
                        <div class="rmain">
                            <div class="rtitle">@(string.IsNullOrWhiteSpace(l.Name) ? l.IdNumber : l.Name)</div>
                            <div class="rmeta mono">@l.IdNumber@(string.IsNullOrWhiteSpace(l.Department) ? "" : $" · {l.Department}")</div>
                        </div>
                        <span class="badge @(l.IsActive ? "active" : "inactive")">@(l.IsActive ? "Active" : "Inactive")</span>
                    </div>
                }
            </div>
            <a class="linkbtn" style="display:inline-block;margin-top:10px" href="/institution/lecturers">Manage lecturers →</a>
        }
    </div>
    <div>
        <div class="section-title" style="margin-top:8px">Recent students</div>
        @if (!_students.Any())
        {
            <div class="empty" style="padding:36px"><div class="big">No students yet</div>Students who register will appear here.</div>
        }
        else
        {
            <div class="listcard">
                @foreach (var s in _students.Take(5))
                {
                    <div class="listrow">
                        <div class="avatar">@Init(s.Name, s.IdNumber)</div>
                        <div class="rmain">
                            <div class="rtitle mono">@s.IdNumber</div>
                            <div class="rmeta">@(string.IsNullOrWhiteSpace(s.ProgrammeOfStudy) ? "—" : s.ProgrammeOfStudy)@(string.IsNullOrWhiteSpace(s.Level) ? "" : $" · Level {s.Level}")</div>
                        </div>
                        <span class="badge @(s.IsActive ? "active" : "inactive")">@(s.IsActive ? "Active" : "Inactive")</span>
                    </div>
                }
            </div>
            <a class="linkbtn" style="display:inline-block;margin-top:10px" href="/institution/students">View all students →</a>
        }
    </div>
</div>

@code {
    private List<UserDto> _lecturers = new();
    private List<UserDto> _students = new();
    private List<ResetRequestDto> _requests = new();
    private string? _resetPwd, _resetName;

    private int ActiveCount => _lecturers.Count(u => u.IsActive) + _students.Count(u => u.IsActive);
    private int InactiveCount => _lecturers.Count(u => !u.IsActive) + _students.Count(u => !u.IsActive);

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsInstitutionAdmin) { Nav.NavigateTo("/login"); return; }
        _lecturers = await Api.GetUsersAsync("Lecturer");
        _students = await Api.GetUsersAsync("Student");
        _requests = await Api.GetResetRequestsAsync();
    }

    private async Task Resolve(ResetRequestDto r)
    {
        var temp = await Api.ResolveResetRequestAsync(r.Id);
        if (temp is not null)
        {
            _resetName = r.IdNumber;
            _resetPwd = temp;
            _requests = await Api.GetResetRequestsAsync();
        }
    }

    private static string Init(string? name, string id)
    {
        var basis = string.IsNullOrWhiteSpace(name) ? id : name;
        var parts = basis.Split(new[] { ' ', '/', '-' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
            : basis.Length >= 2 ? basis[..2].ToUpperInvariant() : basis.ToUpperInvariant();
    }
}
