@page "/platform"
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav

<div class="pagehead"><h1>Institutions</h1></div>

<div class="stats">
    <div class="stat"><span class="n teal">@_all.Count</span><span class="l">Total</span></div>
    <div class="stat"><span class="n warn">@Count("Pending")</span><span class="l">Pending</span></div>
    <div class="stat"><span class="n ok">@Count("Approved")</span><span class="l">Approved</span></div>
    <div class="stat"><span class="n">@Count("Suspended")</span><span class="l">Suspended</span></div>
    <div class="stat"><span class="n err">@Count("Rejected")</span><span class="l">Rejected</span></div>
</div>

<div class="tabs">
    <button class="@Cls("Pending")" @onclick='() => _status = "Pending"'>Pending</button>
    <button class="@Cls("Approved")" @onclick='() => _status = "Approved"'>Approved</button>
    <button class="@Cls("Suspended")" @onclick='() => _status = "Suspended"'>Suspended</button>
    <button class="@(_status == null ? "active" : "")" @onclick="() => _status = null">All</button>
</div>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (!Filtered.Any())
{
    <p class="muted">Nothing here.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Type</th><th>Prefix</th><th>Contact</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var i in Filtered)
            {
                <tr>
                    <td>@i.Name</td>
                    <td>@i.Type</td>
                    <td>@i.Prefix</td>
                    <td>@i.ContactPerson<br /><span class="muted small">@i.ContactEmail</span></td>
                    <td><span class="badge @i.Status.ToLowerInvariant()">@i.Status</span></td>
                    <td class="row-actions">
                        @if (i.Status == "Pending")
                        {
                            <button class="btn btn-sm" @onclick="() => Approve(i)">Approve</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Reject(i)">Reject</button>
                        }
                        else if (i.Status == "Approved")
                        {
                            <button class="btn btn-sm btn-ghost" @onclick="() => Suspend(i)">Suspend</button>
                        }
                        else if (i.Status == "Suspended")
                        {
                            <button class="btn btn-sm" @onclick="() => Reactivate(i)">Reactivate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_cred is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h1>Institution approved</h1>
            <p class="muted small">Share these with @_cred.InstitutionName. The password is shown only once.</p>
            <label>Admin ID</label>
            <div class="cred">@_cred.AdminIdNumber</div>
            <label>Temporary password</label>
            <div class="cred">@_cred.TemporaryPassword</div>
            <button class="btn" @onclick="() => _cred = null">Done</button>
        </div>
    </div>
}

@code {
    private List<InstitutionDto> _all = new();
    private string? _status = "Pending";
    private bool _loading = true;
    private ApproveInstitutionResponse? _cred;

    private IEnumerable<InstitutionDto> Filtered => _status is null ? _all : _all.Where(i => i.Status == _status);
    private int Count(string s) => _all.Count(i => i.Status == s);
    private string Cls(string s) => _status == s ? "active" : "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsPlatformAdmin) { Nav.NavigateTo("/login"); return; }
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _all = await Api.GetInstitutionsAsync(null);
        _loading = false;
    }

    private async Task Approve(InstitutionDto i)
    {
        var r = await Api.ApproveInstitutionAsync(i.Id);
        if (r is not null) { _cred = r; await Load(); }
    }

    private async Task Reject(InstitutionDto i) { await Api.RejectInstitutionAsync(i.Id, "Rejected by platform admin."); await Load(); }
    private async Task Suspend(InstitutionDto i) { await Api.SuspendInstitutionAsync(i.Id); await Load(); }
    private async Task Reactivate(InstitutionDto i) { await Api.ReactivateInstitutionAsync(i.Id); await Load(); }
}
