@page "/login"
@layout AuthLayout
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav

<h1>Sign in</h1>
<p class="muted small" style="margin-top:5px">Platform &amp; institution administrators</p>

<label>ID Number</label>
<input @bind="_id" @bind:event="oninput" @onkeydown="OnKey" placeholder="e.g. ADMIN001 or RWP-ADMIN" />

<label>Password</label>
<div class="pwfield">
    <input type="@(_show ? "text" : "password")" @bind="_pw" @bind:event="oninput" @onkeydown="OnKey" placeholder="Enter your password" />
    <button type="button" class="pwtoggle" @onclick="() => _show = !_show" aria-label="@(_show ? "Hide password" : "Show password")" title="@(_show ? "Hide password" : "Show password")">
        @if (_show)
        {
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-6 10-6 10 6 10 6-3 6-10 6-10-6-10-6z" /><circle cx="12" cy="12" r="3" /><line x1="3" y1="3" x2="21" y2="21" /></svg>
        }
        else
        {
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-6 10-6 10 6 10 6-3 6-10 6-10-6-10-6z" /><circle cx="12" cy="12" r="3" /></svg>
        }
    </button>
</div>

@if (_error is not null) { <div class="error">@_error</div> }

<button class="btn block" style="margin-top:22px" @onclick="DoLogin" disabled="@_busy">
    @(_busy ? "Signing in…" : "Sign in")
</button>

<p class="muted small" style="margin-top:16px">
    <button class="linkbtn" @onclick="() => _forgot = !_forgot">Forgot your password?</button>
</p>

@if (_forgot)
{
    <div class="card" style="margin-top:6px;padding:18px">
        @if (!_forgotSent)
        {
            <p class="muted small" style="margin:0 0 8px">
                Enter your ID number. If an email is on file we'll send a reset code;
                otherwise your administrator will be asked to reset it for you.
            </p>
            <input placeholder="e.g. ADUN/FS/SEN/22/003" @bind="_forgotId" @onkeydown="ForgotKey" />
            <button class="btn block" style="margin-top:12px" @onclick="SendForgot" disabled="@_forgotBusy">
                @(_forgotBusy ? "Sending…" : "Continue")
            </button>
        }
        else if (_resetDone)
        {
            <div style="font-size:13px;font-weight:500">Password updated.</div>
            <p class="muted small" style="margin-top:6px">You can sign in with your new password.</p>
        }
        else
        {
            <p class="muted small" style="margin:0 0 10px">
                If <b>@_forgotId</b> has an email on file, a 6-digit code is on its way — enter it
                below with a new password. No email? Your administrator will reset it instead.
            </p>

            <label>Reset code</label>
            <input placeholder="6-digit code" @bind="_code" maxlength="6" inputmode="numeric" />

            <label>New password</label>
            <div class="pwfield">
                <input type="@(_showReset ? "text" : "password")" @bind="_newPw" @bind:event="oninput" placeholder="Choose a new password" />
                <button type="button" class="pwtoggle" @onclick="() => _showReset = !_showReset">@(_showReset ? "Hide" : "Show")</button>
            </div>

            <div style="margin:10px 0 2px;display:flex;flex-direction:column;gap:5px">
                @foreach (var (met, text) in ResetRules)
                {
                    <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:@(met ? "var(--ok)" : "var(--dim)")">
                        <span style="width:6px;height:6px;border-radius:50%;background:currentColor"></span>@text
                    </div>
                }
            </div>

            @if (_resetError is not null) { <div class="error">@_resetError</div> }

            <button class="btn block" style="margin-top:14px" @onclick="CompleteReset" disabled="@(_resetBusy || !CanReset)">
                @(_resetBusy ? "Updating…" : "Reset password")
            </button>
            <button class="linkbtn" style="margin-top:10px" @onclick="SendForgot" disabled="@_forgotBusy">Resend code</button>
        }
    </div>
}

<p class="muted small" style="margin-top:20px">
    Registering a school? <a href="/apply">Apply here</a>
</p>

@code {
    private string _id = "";
    private string _pw = "";
    private string? _error;
    private bool _busy;
    private bool _show;
    private bool _forgot, _forgotSent, _forgotBusy;
    private string _forgotId = "";

    private string _code = "", _newPw = "";
    private bool _resetBusy, _resetDone, _showReset;
    private string? _resetError;

    private (bool, string)[] ResetRules => new[]
    {
        (_newPw.Length >= 8, "At least 8 characters"),
        (_newPw.Any(char.IsUpper), "An uppercase letter"),
        (_newPw.Any(char.IsDigit), "A number"),
        (_newPw.Any(c => !char.IsLetterOrDigit(c)), "A special character")
    };

    private bool CanReset => _code.Trim().Length > 0 && ResetRules.All(r => r.Item1);

    private void ForgotKey(KeyboardEventArgs e) { if (e.Key == "Enter") _ = SendForgot(); }

    private async Task SendForgot()
    {
        if (string.IsNullOrWhiteSpace(_forgotId)) return;
        _forgotBusy = true;
        await Api.ForgotPasswordAsync(_forgotId.Trim());
        _forgotBusy = false;
        _forgotSent = true;   // same answer whether the ID exists or has an email
    }

    private async Task CompleteReset()
    {
        _resetError = null;
        _resetBusy = true;
        var (ok, error) = await Api.ResetWithCodeAsync(_forgotId.Trim(), _code.Trim(), _newPw);
        _resetBusy = false;

        if (ok) _resetDone = true;
        else _resetError = error;
    }

    private async Task DoLogin()
    {
        _error = null;
        _busy = true;
        var (ok, error, data) = await Api.LoginAsync(_id.Trim(), _pw);
        _busy = false;

        if (!ok || data is null) { _error = error; return; }

        Auth.Set(data.AccessToken, data.User.Role, data.User.IdNumber, data.User.MustChangePassword);

        // Temporary credentials must be replaced before anything else.
        Nav.NavigateTo(data.User.MustChangePassword ? "/settings" : Landing(data.User.Role));
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = DoLogin();
    }

    private static string Landing(string role) => role switch
    {
        "PlatformAdmin" or "Admin" => "/platform",
        "InstitutionAdmin" => "/institution",
        _ => "/login"
    };
}
