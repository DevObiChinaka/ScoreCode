@page "/institution"
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav

<div class="pagehead">
    <h1>Lecturers</h1>
    <button class="btn btn-sm" @onclick="() => _showForm = !_showForm">@(_showForm ? "Close" : "+ New lecturer")</button>
</div>

<div class="stats">
    <div class="stat"><span class="n teal">@_lecturers.Count</span><span class="l">Lecturers</span></div>
    <div class="stat"><span class="n">@_students.Count</span><span class="l">Students</span></div>
</div>

@if (_showForm)
{
    <div class="card" style="margin-bottom:20px;max-width:none">
        <label>Full name</label>
        <input @bind="_req.Name" />
        <label>Staff ID</label>
        <input @bind="_req.StaffId" />
        <label>Department</label>
        <input @bind="_req.Department" />
        <label>Temporary password</label>
        <input type="password" @bind="_req.Password" />

        @if (_error is not null) { <div class="error">@_error</div> }
        @if (_created is not null) { <div class="success">Created lecturer @_created.</div> }

        <button class="btn" @onclick="Create" disabled="@_busy">@(_busy ? "Creating…" : "Create lecturer")</button>
    </div>
}

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_lecturers.Count == 0)
{
    <p class="muted">No lecturers yet. Add your first one above.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Staff ID</th><th>Department</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var l in _lecturers)
            {
                <tr>
                    <td>@l.Name</td>
                    <td>@l.IdNumber</td>
                    <td>@l.Department</td>
                    <td>@(l.IsActive ? "Active" : "Inactive")</td>
                    <td class="row-actions">
                        @if (l.IsActive)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => SetActive(l, false)">Deactivate</button>
                        }
                        else
                        {
                            <button class="btn btn-sm" @onclick="() => SetActive(l, true)">Activate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="pagehead" style="margin-top:32px"><h1>Students</h1><span class="muted small">@_students.Count registered</span></div>
@if (!_loading && _students.Count == 0)
{
    <p class="muted">No students have registered under your institution yet.</p>
}
else if (!_loading)
{
    <table>
        <thead>
            <tr><th>Matric Number</th><th>Programme</th><th>Level</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in _students)
            {
                <tr>
                    <td>@s.IdNumber</td>
                    <td>@s.ProgrammeOfStudy</td>
                    <td>@s.Level</td>
                    <td>@(s.IsActive ? "Active" : "Inactive")</td>
                    <td class="row-actions">
                        @if (s.IsActive)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => SetActive(s, false)">Deactivate</button>
                        }
                        else
                        {
                            <button class="btn btn-sm" @onclick="() => SetActive(s, true)">Activate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<UserDto> _lecturers = new();
    private List<UserDto> _students = new();
    private bool _loading = true;
    private bool _showForm;
    private bool _busy;
    private CreateLecturerRequest _req = new();
    private string? _error;
    private string? _created;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsInstitutionAdmin) { Nav.NavigateTo("/login"); return; }
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _lecturers = await Api.GetUsersAsync("Lecturer");
        _students = await Api.GetUsersAsync("Student");
        _loading = false;
    }

    private async Task SetActive(UserDto u, bool active)
    {
        await Api.SetUserActiveAsync(u.Id, active);
        await Load();
    }

    private async Task Create()
    {
        _error = null;
        _created = null;
        if (string.IsNullOrWhiteSpace(_req.Name) ||
            string.IsNullOrWhiteSpace(_req.StaffId) ||
            string.IsNullOrWhiteSpace(_req.Password))
        {
            _error = "Name, staff ID and password are required.";
            return;
        }

        _busy = true;
        var (ok, error) = await Api.CreateLecturerAsync(_req);
        _busy = false;

        if (ok)
        {
            _created = _req.StaffId;
            _req = new();
            _showForm = false;
            await Load();
        }
        else
        {
            _error = error;
        }
    }
}
