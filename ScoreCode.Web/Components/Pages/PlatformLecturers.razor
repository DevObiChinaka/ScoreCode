@page "/platform/lecturers"
@layout DashboardLayout
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav

<div class="pagehead">
    <div><h1>Lecturers</h1><div class="sub">@_all.Count lecturer(s) across @InstitutionCount institution(s)</div></div>
</div>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_all.Count == 0)
{
    <div class="empty"><div class="big">No lecturers yet</div>Lecturers created by institutions will appear here.</div>
}
else
{
    <div class="toolbar">
        <div class="searchbox">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <input placeholder="Search by name, staff ID or department…" @bind="_search" @bind:event="oninput" />
        </div>
        <select style="width:auto;min-width:220px" @bind="_inst">
            <option value="">All institutions</option>
            @foreach (var name in _all.Select(u => Inst(u)).Distinct().OrderBy(n => n))
            {
                <option value="@name">@name</option>
            }
        </select>
    </div>

    @if (!Filtered.Any())
    {
        <div class="empty"><div class="big">No matching lecturers</div>Try a different search or institution.</div>
    }
    else
    {
        @foreach (var inst in Filtered.GroupBy(Inst).OrderBy(g => g.Key))
        {
            var open = IsOpen(inst.Key);
            <div class="group">
                <button class="group-head @(open ? "open" : "")" @onclick="() => Toggle(inst.Key)">
                    <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                    <span class="gtitle">@inst.Key</span>
                    <span class="gmeta">· @inst.Select(l => Dept(l)).Distinct().Count() department(s)</span>
                    <span class="gcount">@inst.Count()</span>
                </button>
                @if (open)
                {
                    <div class="group-body">
                        @foreach (var sub in inst.GroupBy(Dept).OrderBy(g => g.Key))
                        {
                            <div class="subgroup">
                                <div class="subgroup-head">
                                    <span>@sub.Key</span>
                                    <span class="sgcount">@sub.Count()</span>
                                </div>
                                @foreach (var l in sub.OrderBy(x => x.Name))
                                {
                                    <div class="prow">
                                        <div class="pmain">
                                            <div class="pname">@(string.IsNullOrWhiteSpace(l.Name) ? l.IdNumber : l.Name)</div>
                                            <div class="psub mono">@l.IdNumber</div>
                                        </div>
                                        <span class="badge @(l.IsActive ? "active" : "inactive")">@(l.IsActive ? "Active" : "Inactive")</span>
                                        <button class="btn btn-sm btn-outline" @onclick="() => ResetPassword(l)">Reset password</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
}

@if (_resetPwd is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h2>Password reset</h2>
            <p class="muted small" style="margin:6px 0 12px">New temporary password for <b>@_resetName</b>. Share it securely — shown only once.</p>
            <label>Temporary password</label>
            <div class="cred">@_resetPwd</div>
            <button class="btn block" style="margin-top:18px" @onclick="() => _resetPwd = null">Done</button>
        </div>
    </div>
}

@code {
    private List<UserDto> _all = new();
    private bool _loading = true;
    private string _search = "";
    private string _inst = "";
    private string? _resetPwd;
    private string? _resetName;
    private readonly HashSet<string> _collapsed = new();

    private static string Inst(UserDto u) => string.IsNullOrWhiteSpace(u.InstitutionName) ? "Unassigned" : u.InstitutionName;
    private static string Dept(UserDto u) => string.IsNullOrWhiteSpace(u.Department) ? "Unspecified department" : u.Department;

    private int InstitutionCount => _all.Select(Inst).Distinct().Count();

    private bool IsOpen(string key) => _search.Length > 0 || !_collapsed.Contains(key);
    private void Toggle(string key)
    {
        if (!_collapsed.Remove(key)) _collapsed.Add(key);
    }

    private IEnumerable<UserDto> Filtered => _all
        .Where(u => _inst.Length == 0 || Inst(u) == _inst)
        .Where(u => _search.Length == 0
            || (u.Name ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (u.IdNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (u.Department ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsPlatformAdmin) { Nav.NavigateTo("/login"); return; }
        _all = await Api.GetUsersAsync("Lecturer");
        _loading = false;
    }

    private async Task ResetPassword(UserDto u)
    {
        var temp = await Api.ResetUserPasswordAsync(u.Id);
        if (temp is not null)
        {
            _resetName = string.IsNullOrWhiteSpace(u.Name) ? u.IdNumber : u.Name;
            _resetPwd = temp;
        }
    }
}
