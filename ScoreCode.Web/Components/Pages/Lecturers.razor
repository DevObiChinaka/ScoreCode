@page "/institution/lecturers"
@layout DashboardLayout
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav

<div class="pagehead">
    <div><h1>Lecturers</h1><div class="sub">@_lecturers.Count lecturer(s) in your institution</div></div>
    <button class="btn" @onclick="() => _showForm = !_showForm">@(_showForm ? "Close" : "+ New lecturer")</button>
</div>

@if (_showForm)
{
    <div class="card" style="margin-bottom:22px">
        <label>Full name</label>
        <input @bind="_req.Name" />
        <label>Staff ID</label>
        <input @bind="_req.StaffId" />
        <label>Department</label>
        <input @bind="_req.Department" />
        <label>Email <span class="muted small">(optional — lets them reset their own password)</span></label>
        <input type="email" @bind="_req.Email" placeholder="name@school.edu" />
        <label>Temporary password</label>
        <input type="password" @bind="_req.Password" />

        @if (_error is not null) { <div class="error">@_error</div> }
        @if (_created is not null) { <div class="success">Created lecturer @_created.</div> }

        <button class="btn" style="margin-top:20px" @onclick="Create" disabled="@_busy">
            @(_busy ? "Creating…" : "Create lecturer")
        </button>
    </div>
}

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_lecturers.Count == 0)
{
    <div class="empty"><div class="big">No lecturers yet</div>Add your first lecturer above.</div>
}
else
{
    <div class="toolbar">
        <div class="searchbox">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <input placeholder="Search by name, staff ID or department…" @bind="_search" @bind:event="oninput" />
        </div>
        <div class="tabs">
            <button class="@(_filter=="all"?"active":"")" @onclick='() => _filter="all"'>All <span class="cnt">@_lecturers.Count</span></button>
            <button class="@(_filter=="active"?"active":"")" @onclick='() => _filter="active"'>Active <span class="cnt">@_lecturers.Count(l => l.IsActive)</span></button>
            <button class="@(_filter=="inactive"?"active":"")" @onclick='() => _filter="inactive"'>Inactive <span class="cnt">@_lecturers.Count(l => !l.IsActive)</span></button>
        </div>
    </div>

    @if (!Filtered.Any())
    {
        <div class="empty"><div class="big">No matching lecturers</div>Try a different search or filter.</div>
    }
    else
    {
    <div class="tablewrap">
        <table>
            <thead>
                <tr><th>Name</th><th>Staff ID</th><th>Department</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var l in Filtered)
                {
                    <tr>
                        <td>@l.Name</td>
                        <td>@l.IdNumber</td>
                        <td>@l.Department</td>
                        <td><span class="badge @(l.IsActive ? "active" : "inactive")">@(l.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="row-actions">
                            <button class="btn btn-sm btn-outline" @onclick="() => _editing = l">Edit</button>
                            <button class="btn btn-sm btn-outline" @onclick="() => ResetPassword(l)">Reset password</button>
                            @if (l.IsActive)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => SetActive(l, false)">Deactivate</button>
                            }
                            else
                            {
                                <button class="btn btn-sm" @onclick="() => SetActive(l, true)">Activate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
}

@if (_editing is not null)
{
    <EditUserDialog User="_editing" OnCancel="() => _editing = null" OnSaved="ReloadAfterEdit" />
}

@if (_resetPwd is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h2>Password reset</h2>
            <p class="muted small" style="margin:6px 0 12px">New temporary password for <b>@_resetName</b>. Share it securely — it's shown only once, and they'll be asked to change it.</p>
            <label>Temporary password</label>
            <div class="cred">@_resetPwd</div>
            <button class="btn block" style="margin-top:18px" @onclick="() => _resetPwd = null">Done</button>
        </div>
    </div>
}

@code {
    private List<UserDto> _lecturers = new();
    private bool _loading = true;
    private bool _showForm;
    private bool _busy;
    private CreateLecturerRequest _req = new();
    private string? _error;
    private string? _created;
    private string? _resetPwd;
    private string? _resetName;
    private string _search = "";
    private string _filter = "all";
    private UserDto? _editing;

    private async Task ReloadAfterEdit()
    {
        _editing = null;
        await Load();
    }

    private IEnumerable<UserDto> Filtered => _lecturers
        .Where(l => _filter == "all" || (_filter == "active" ? l.IsActive : !l.IsActive))
        .Where(l => _search.Length == 0
            || (l.Name ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (l.IdNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (l.Department ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsInstitutionAdmin) { Nav.NavigateTo("/login"); return; }
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _lecturers = await Api.GetUsersAsync("Lecturer");
        _loading = false;
    }

    private async Task SetActive(UserDto u, bool active)
    {
        await Api.SetUserActiveAsync(u.Id, active);
        await Load();
    }

    private async Task ResetPassword(UserDto u)
    {
        var temp = await Api.ResetUserPasswordAsync(u.Id);
        if (temp is not null)
        {
            _resetName = string.IsNullOrWhiteSpace(u.Name) ? u.IdNumber : u.Name;
            _resetPwd = temp;
        }
    }

    private async Task Create()
    {
        _error = null;
        _created = null;
        if (string.IsNullOrWhiteSpace(_req.Name) ||
            string.IsNullOrWhiteSpace(_req.StaffId) ||
            string.IsNullOrWhiteSpace(_req.Password))
        {
            _error = "Name, staff ID and password are required.";
            return;
        }

        _busy = true;
        var (ok, error) = await Api.CreateLecturerAsync(_req);
        _busy = false;

        if (ok)
        {
            _created = _req.StaffId;
            _req = new();
            _showForm = false;
            await Load();
        }
        else
        {
            _error = error;
        }
    }
}
