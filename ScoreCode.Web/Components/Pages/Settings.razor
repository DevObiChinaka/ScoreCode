@page "/settings"
@layout DashboardLayout
@inject ApiClient Api
@inject WebAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="pagehead">
    <div><h1>Settings</h1><div class="sub">Your account, security and preferences</div></div>
</div>

<div style="max-width:640px">
    @if (Auth.MustChangePassword)
    {
        <div class="error" style="margin:0 0 18px">
            You're signed in with a temporary password. Please set your own password below.
        </div>
    }

    <div class="section-title" style="margin-top:0">Account</div>
    <div class="listcard">
        <div class="listrow"><div class="rmain"><div class="rmeta">ID number</div></div><span class="mono">@(_me?.IdNumber ?? Auth.Name)</span></div>
        <div class="listrow"><div class="rmain"><div class="rmeta">Role</div></div><span>@RoleLabel</span></div>
        @if (!string.IsNullOrWhiteSpace(_me?.Name))
        {
            <div class="listrow"><div class="rmain"><div class="rmeta">Name</div></div><span>@_me!.Name</span></div>
        }
        @if (!string.IsNullOrWhiteSpace(_me?.InstitutionName))
        {
            <div class="listrow"><div class="rmain"><div class="rmeta">Institution</div></div><span>@_me!.InstitutionName</span></div>
        }
    </div>

    <div class="section-title">Security</div>
    <div class="card">
        <label>Current password</label>
        <div class="pwfield">
            <input type="@(_showCur ? "text" : "password")" @bind="_cur" @bind:event="oninput" placeholder="Enter current password" />
            <button type="button" class="pwtoggle" @onclick="() => _showCur = !_showCur" title="@(_showCur ? "Hide" : "Show")">@Eye(_showCur)</button>
        </div>

        <label>New password</label>
        <div class="pwfield">
            <input type="@(_showNew ? "text" : "password")" @bind="_new" @bind:event="oninput" placeholder="Enter new password" />
            <button type="button" class="pwtoggle" @onclick="() => _showNew = !_showNew" title="@(_showNew ? "Hide" : "Show")">@Eye(_showNew)</button>
        </div>

        <div style="margin:12px 0 4px;display:flex;flex-direction:column;gap:6px">
            @foreach (var (met, text) in Rules)
            {
                <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:@(met ? "var(--ok)" : "var(--dim)")">
                    <span style="width:6px;height:6px;border-radius:50%;background:currentColor"></span>@text
                </div>
            }
        </div>

        <label>Confirm new password</label>
        <div class="pwfield">
            <input type="@(_showCon ? "text" : "password")" @bind="_confirm" @bind:event="oninput" placeholder="Re-enter new password" />
            <button type="button" class="pwtoggle" @onclick="() => _showCon = !_showCon" title="@(_showCon ? "Hide" : "Show")">@Eye(_showCon)</button>
        </div>
        @if (_confirm.Length > 0 && _confirm != _new)
        {
            <div style="font-size:12px;color:var(--err);margin-top:7px">Passwords do not match.</div>
        }

        @if (_error is not null) { <div class="error">@_error</div> }
        @if (_ok) { <div class="success">Password changed successfully.</div> }

        <button class="btn" style="margin-top:18px" @onclick="Save" disabled="@(_busy || !CanSave)">
            @(_busy ? "Changing…" : "Change password")
        </button>
    </div>

    <div class="section-title">Appearance</div>
    <div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:16px">
        <div>
            <div style="font-weight:500">Theme</div>
            <div class="muted small" style="margin-top:3px">Switch between light and dark</div>
        </div>
        <button class="btn btn-outline" @onclick="ToggleTheme">@(_theme == "light" ? "Light" : "Dark")</button>
    </div>
</div>

@code {
    private UserDto? _me;
    private string _cur = "", _new = "", _confirm = "";
    private bool _showCur, _showNew, _showCon, _busy, _ok;
    private string? _error;
    private string _theme = "dark";

    private string RoleLabel =>
        Auth.IsPlatformAdmin ? "Platform Admin"
        : Auth.IsInstitutionAdmin ? "Institution Admin"
        : Auth.Role;

    private (bool, string)[] Rules => new[]
    {
        (_new.Length >= 8, "At least 8 characters"),
        (_new.Any(char.IsUpper), "At least one uppercase letter"),
        (_new.Any(char.IsDigit), "At least one number"),
        (_new.Any(c => !char.IsLetterOrDigit(c)), "At least one special character")
    };

    private bool CanSave => _cur.Length > 0 && Rules.All(r => r.Item1) && _new == _confirm;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        _me = await Api.GetMeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("scGetTheme");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme() => _theme = await JS.InvokeAsync<string>("scToggleTheme");

    private async Task Save()
    {
        _error = null; _ok = false; _busy = true;
        var (ok, error) = await Api.ChangePasswordAsync(_cur, _new);
        _busy = false;

        if (ok)
        {
            _ok = true;
            _cur = _new = _confirm = "";
            Auth.PasswordChanged();   // clears the temporary-password banner
        }
        else _error = error;
    }

    private static MarkupString Eye(bool shown) => new(
        shown
            ? "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 12s3-6 10-6 10 6 10 6-3 6-10 6-10-6-10-6z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/><line x1=\"3\" y1=\"3\" x2=\"21\" y2=\"21\"/></svg>"
            : "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 12s3-6 10-6 10 6 10 6-3 6-10 6-10-6-10-6z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>");
}
