@inherits LayoutComponentBase
@inject WebAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <svg class="logo sm" viewBox="0 0 48 48" fill="none">
                <rect x="0.5" y="0.5" width="47" height="47" rx="12" fill="var(--logo-tile)" stroke="var(--logo-stroke)" />
                <path d="M33.64 12.51 A15 15 0 0 0 9 24" stroke="var(--text)" stroke-width="5" stroke-linecap="round" />
                <path d="M9 24 A15 15 0 0 0 33.64 35.49" stroke="#3b74f0" stroke-width="5" stroke-linecap="round" />
                <polyline points="21 17 30 24 21 31" stroke="#14b88a" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>ScoreCode</span>
        </div>
        <nav>
            @if (Auth.IsPlatformAdmin)
            {
                <NavLink class="navitem" href="/platform" Match="NavLinkMatch.All">@Ico.Home Overview</NavLink>
                <NavLink class="navitem" href="/platform/analytics">@Ico.Chart Analytics</NavLink>
                <NavLink class="navitem" href="/platform/institutions">@Ico.Building Institutions</NavLink>
                <NavLink class="navitem" href="/platform/lecturers">@Ico.Users Lecturers</NavLink>
                <NavLink class="navitem" href="/platform/students">@Ico.Cap Students</NavLink>
            }
            @if (Auth.IsInstitutionAdmin)
            {
                <NavLink class="navitem" href="/institution" Match="NavLinkMatch.All">@Ico.Home Overview</NavLink>
                <NavLink class="navitem" href="/institution/analytics">@Ico.Chart Analytics</NavLink>
                <NavLink class="navitem" href="/institution/lecturers">@Ico.Users Lecturers</NavLink>
                <NavLink class="navitem" href="/institution/students">@Ico.Cap Students</NavLink>
                <NavLink class="navitem" href="/institution/exams">@Ico.File Exams</NavLink>
            }
            @if (Auth.IsAuthenticated)
            {
                <NavLink class="navitem" href="/settings">@Ico.Cog Settings</NavLink>
            }
        </nav>
        <div class="sidebar-user">
            <div class="urow">
                <div class="avatar">@Initials</div>
                <div style="min-width:0">
                    <div class="name">@Auth.Name</div>
                    <div class="role">@RoleLabel</div>
                </div>
            </div>
            <button class="sidebar-signout" @onclick="Logout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                Sign out
            </button>
        </div>
    </aside>
    <div class="main">
        <header class="topbar">
            <span class="crumb">@RoleLabel</span>
            <button class="iconbtn" @onclick="ToggleTheme" title="Toggle light / dark" style="margin-right:-4px">
                @if (_theme == "light")
                {
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                }
                else
                {
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                }
            </button>
        </header>
        <div class="scrollarea">
            <main class="content">
                @Body
            </main>
        </div>
    </div>
</div>

@code {
    private string Initials =>
        string.IsNullOrWhiteSpace(Auth.Name)
            ? "?"
            : string.Concat(Auth.Name
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(w => char.ToUpperInvariant(w[0])));

    private string RoleLabel =>
        Auth.IsPlatformAdmin ? "Platform Admin"
        : Auth.IsInstitutionAdmin ? "Institution Admin"
        : Auth.Role;

    private string _theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("scGetTheme");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _theme = await JS.InvokeAsync<string>("scToggleTheme");
    }

    private void Logout()
    {
        Auth.Clear();
        Nav.NavigateTo("/login");
    }
}
