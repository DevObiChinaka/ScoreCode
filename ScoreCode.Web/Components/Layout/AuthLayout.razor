@inherits LayoutComponentBase

<div class="auth-shell">
    <div class="auth-brand">
        <div class="logo-row">
            <svg class="logo" viewBox="0 0 48 48" fill="none">
                <rect x="0.5" y="0.5" width="47" height="47" rx="12" fill="var(--logo-tile)" stroke="var(--logo-stroke)" />
                <path d="M33.64 12.51 A15 15 0 0 0 9 24" stroke="var(--text)" stroke-width="5" stroke-linecap="round" />
                <path d="M9 24 A15 15 0 0 0 33.64 35.49" stroke="#3b74f0" stroke-width="5" stroke-linecap="round" />
                <polyline points="21 17 30 24 21 31" stroke="#14b88a" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="brand-name">ScoreCode&nbsp;<em>Portal</em></div>
        </div>
        <h2>Secure exam management for every institution.</h2>
        <p>Register your school, manage lecturers and students, and run locked-down coding exams — all in one place.</p>
    </div>
    <div class="auth-form">
        <div class="inner">
            @Body
        </div>
    </div>
</div>
